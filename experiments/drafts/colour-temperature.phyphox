<?xml version='1.0' encoding='utf-8'?>
<phyphox version="1.17" locale="en">
  <!--This adapted experiment retains LGPL-3.0-or-later terms. See COPYING.LESSER and LICENSE in the repository or draft bundle.-->
  <!--Original Curious Signals optics draft; see companion manuscript for source anchors, method and limitations.-->
  <!--Conversion attribution retained: Sebastian J. Spicker / Frederic Bouquet; original Gautier Creutzer / Frederic Bouquet; McWethy colour helpers. Donor 0beta_color-temperature_illuminance.phyphox states LGPL-3.0-or-later. Guarded reimplementation, no article prose copied.-->
  <title>Draft: Indicative colour temperature</title>
  <category>Curious Signals drafts</category>
  <description>Acquire Nano mode 6 RGBC counts; dark-correct and normalize by clear, apply an editable provisional RGB-to-XYZ matrix, and export chromaticity and a guarded indicative McCamy CCT. Absolute interpretation requires calibration.</description>
  <icon>Opt</icon>
  <data-containers>
    <container size="0">device_t</container>
    <container size="0">clear</container>
    <container size="0">red</container>
    <container size="0">green</container>
    <container size="0">blue</container>
    <container size="0">receive_t</container>
    <container size="1" init="0">enabled</container>
    <container size="1" init="4100">ceiling</container>
    <container size="1" init="0">dark_clear</container>
    <container size="1" init="0">dark_red</container>
    <container size="1" init="0">dark_green</container>
    <container size="1" init="0">dark_blue</container>
    <container size="0">clear_corrected</container>
    <container size="0">ratio_red</container>
    <container size="0">ratio_green</container>
    <container size="0">ratio_blue</container>
    <container size="1" init="-0.14282">mXred</container>
    <container size="1" init="1.54924">mXgreen</container>
    <container size="1" init="-0.95641">mXblue</container>
    <container size="0">X</container>
    <container size="1" init="-0.32466">mYred</container>
    <container size="1" init="1.57837">mYgreen</container>
    <container size="1" init="-0.73191">mYblue</container>
    <container size="0">Y</container>
    <container size="1" init="-0.68202">mZred</container>
    <container size="1" init="0.77073">mZgreen</container>
    <container size="1" init="0.56332">mZblue</container>
    <container size="0">Z</container>
    <container size="0">xyz_sum</container>
    <container size="0">chroma_x</container>
    <container size="0">chroma_y</container>
    <container size="0">n</container>
    <container size="0">cct_candidate</container>
    <container size="0">cct</container>
  </data-containers>
  <input>
    <bluetooth name="phyphox-sense" id="Sense" mode="notification" subscribeOnStart="false">
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">device_t</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">clear</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">red</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">green</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">blue</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" extra="time">receive_t</output>
    </bluetooth>
  </input>
  <output>
    <bluetooth id="Sense">
      <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian">6</config>
    </bluetooth>
  </output>
  <analysis sleep="0.1" onUserInput="false">
    <formula formula="([1_]-[2])/(max(0,sign([1_]-[2]))/max(0,sign([1_]-[2])))">
      <input clear="false">clear</input>
      <input clear="false">dark_clear</input>
      <output clear="true">clear_corrected</output>
    </formula>
    <formula formula="([1_]-[2])/[3_]/((heaviside([1_]-[2])/heaviside([1_]-[2]))*(max(0,sign([4]-max([1_],[5_])))/max(0,sign([4]-max([1_],[5_])))))">
      <input clear="false">red</input>
      <input clear="false">dark_red</input>
      <input clear="false">clear_corrected</input>
      <input clear="false">ceiling</input>
      <input clear="false">clear</input>
      <output clear="true">ratio_red</output>
    </formula>
    <formula formula="([1_]-[2])/[3_]/((heaviside([1_]-[2])/heaviside([1_]-[2]))*(max(0,sign([4]-max([1_],[5_])))/max(0,sign([4]-max([1_],[5_])))))">
      <input clear="false">green</input>
      <input clear="false">dark_green</input>
      <input clear="false">clear_corrected</input>
      <input clear="false">ceiling</input>
      <input clear="false">clear</input>
      <output clear="true">ratio_green</output>
    </formula>
    <formula formula="([1_]-[2])/[3_]/((heaviside([1_]-[2])/heaviside([1_]-[2]))*(max(0,sign([4]-max([1_],[5_])))/max(0,sign([4]-max([1_],[5_])))))">
      <input clear="false">blue</input>
      <input clear="false">dark_blue</input>
      <input clear="false">clear_corrected</input>
      <input clear="false">ceiling</input>
      <input clear="false">clear</input>
      <output clear="true">ratio_blue</output>
    </formula>
    <formula formula="[1]*[2_]+[3]*[4_]+[5]*[6_]">
      <input clear="false">mXred</input>
      <input clear="false">ratio_red</input>
      <input clear="false">mXgreen</input>
      <input clear="false">ratio_green</input>
      <input clear="false">mXblue</input>
      <input clear="false">ratio_blue</input>
      <output clear="true">X</output>
    </formula>
    <formula formula="[1]*[2_]+[3]*[4_]+[5]*[6_]">
      <input clear="false">mYred</input>
      <input clear="false">ratio_red</input>
      <input clear="false">mYgreen</input>
      <input clear="false">ratio_green</input>
      <input clear="false">mYblue</input>
      <input clear="false">ratio_blue</input>
      <output clear="true">Y</output>
    </formula>
    <formula formula="[1]*[2_]+[3]*[4_]+[5]*[6_]">
      <input clear="false">mZred</input>
      <input clear="false">ratio_red</input>
      <input clear="false">mZgreen</input>
      <input clear="false">ratio_green</input>
      <input clear="false">mZblue</input>
      <input clear="false">ratio_blue</input>
      <output clear="true">Z</output>
    </formula>
    <formula formula="[1_]+[2_]+[3_]">
      <input clear="false">X</input>
      <input clear="false">Y</input>
      <input clear="false">Z</input>
      <output clear="true">xyz_sum</output>
    </formula>
    <formula formula="[1_]/[2_]/((max(0,sign([2_]))/max(0,sign([2_])))*(heaviside([3_])/heaviside([3_]))*(max(0,sign([4_]))/max(0,sign([4_])))*(heaviside([5_])/heaviside([5_])))">
      <input clear="false">X</input>
      <input clear="false">xyz_sum</input>
      <input clear="false">X</input>
      <input clear="false">Y</input>
      <input clear="false">Z</input>
      <output clear="true">chroma_x</output>
    </formula>
    <formula formula="[1_]/[2_]/((max(0,sign([2_]))/max(0,sign([2_])))*(heaviside([3_])/heaviside([3_]))*(max(0,sign([4_]))/max(0,sign([4_])))*(heaviside([5_])/heaviside([5_])))">
      <input clear="false">Y</input>
      <input clear="false">xyz_sum</input>
      <input clear="false">X</input>
      <input clear="false">Y</input>
      <input clear="false">Z</input>
      <output clear="true">chroma_y</output>
    </formula>
    <formula formula="([1_]-0.3320)/(0.1858-[2_])/(max(0,sign(abs(0.1858-[2_])-0.001))/max(0,sign(abs(0.1858-[2_])-0.001)))">
      <input clear="false">chroma_x</input>
      <input clear="false">chroma_y</input>
      <output clear="true">n</output>
    </formula>
    <formula formula="449*[1_]^3+3525*[1_]^2+6823.3*[1_]+5520.33">
      <input clear="false">n</input>
      <output clear="true">cct_candidate</output>
    </formula>
    <formula formula="[1_]/((max(0,sign([2]-0.5))/max(0,sign([2]-0.5)))*(max(0,sign([1_]-2000))/max(0,sign([1_]-2000)))*(max(0,sign(10000-[1_]))/max(0,sign(10000-[1_])))*(max(0,sign([3_]))/max(0,sign([3_])))*(max(0,sign([4_]))/max(0,sign([4_])))*(max(0,sign(1-[3_]-[4_]))/max(0,sign(1-[3_]-[4_]))))">
      <input clear="false">cct_candidate</input>
      <input clear="false">enabled</input>
      <input clear="false">chroma_x</input>
      <input clear="false">chroma_y</input>
      <output clear="true">cct</output>
    </formula>
  </analysis>
  <views>
    <view label="Colour">
      <graph label="Indicative CCT (calibration required)" labelX="Time" labelY="Signal" unitX="s" unitY="K" partialUpdate="false" style="lines">
        <input axis="x">device_t</input>
        <input axis="y">cct</input>
      </graph>
      <graph label="Provisional chromaticity" labelX="x" labelY="y" unitX="1" unitY="1" partialUpdate="false" style="dots">
        <input axis="x">chroma_x</input>
        <input axis="y">chroma_y</input>
      </graph>
      <value label="Indicative CCT" unit="K" precision="4">
        <input>cct</input>
      </value>
    </view>
    <view label="Calibration">
      <edit label="Colour calibration checked (0 or 1)" default="0" unit="" signed="true" decimal="true" min="0" max="1">
        <output>enabled</output>
      </edit>
      <edit label="Count ceiling (screening only)" default="4100" unit="counts" signed="true" decimal="true">
        <output>ceiling</output>
      </edit>
      <edit label="Dark clear" default="0" unit="counts" signed="true" decimal="true">
        <output>dark_clear</output>
      </edit>
      <edit label="Dark red" default="0" unit="counts" signed="true" decimal="true">
        <output>dark_red</output>
      </edit>
      <edit label="Dark green" default="0" unit="counts" signed="true" decimal="true">
        <output>dark_green</output>
      </edit>
      <edit label="Dark blue" default="0" unit="counts" signed="true" decimal="true">
        <output>dark_blue</output>
      </edit>
      <edit label="X coefficient red" default="-0.14282" unit="" signed="true" decimal="true">
        <output>mXred</output>
      </edit>
      <edit label="X coefficient green" default="1.54924" unit="" signed="true" decimal="true">
        <output>mXgreen</output>
      </edit>
      <edit label="X coefficient blue" default="-0.95641" unit="" signed="true" decimal="true">
        <output>mXblue</output>
      </edit>
      <edit label="Y coefficient red" default="-0.32466" unit="" signed="true" decimal="true">
        <output>mYred</output>
      </edit>
      <edit label="Y coefficient green" default="1.57837" unit="" signed="true" decimal="true">
        <output>mYgreen</output>
      </edit>
      <edit label="Y coefficient blue" default="-0.73191" unit="" signed="true" decimal="true">
        <output>mYblue</output>
      </edit>
      <edit label="Z coefficient red" default="-0.68202" unit="" signed="true" decimal="true">
        <output>mZred</output>
      </edit>
      <edit label="Z coefficient green" default="0.77073" unit="" signed="true" decimal="true">
        <output>mZgreen</output>
      </edit>
      <edit label="Z coefficient blue" default="0.56332" unit="" signed="true" decimal="true">
        <output>mZblue</output>
      </edit>
      <info label="Defaults are donor coefficients, not a calibration of this board. Verify dark offsets, linearity and matrix using independent colour references spanning your source family before setting Colour calibration checked to 1. CCT is suppressed outside 2000-10000 K, near y=0.1858 or for nonphysical XYZ/chromaticity; these are screening bounds, not a proof of proximity to the Planckian locus." />
    </view>
    <view label="Setup">
      <info label="Use original Nano 33 BLE Sense APDS-9960, fixed aperture and current mode 6 firmware. Keep lamp geometry, sensor gain and ambient light fixed. Measure covered-sensor dark counts. Avoid the nominal count ceiling and independently test linearity." />
      <info label="Compare stable continuous-spectrum lamps only within a calibrated source family. RGB and clear give four broad-band counts, not a spectrum. Fluorescent and narrow-band LED colours can violate the CCT assumptions. Inspect provisional XYZ and chromaticity before using indicative CCT." />
      <info label="The adopted sign convention is n=(x-0.3320)/(0.1858-y) with +449 n³ +3525 n² +6823.3 n +5520.33. Changing the denominator sign requires changing odd-power signs. No illuminance/lux is inferred. CCT is not a stellar surface-temperature measurement, molecular identification or a UV measurement. Settings recompute the entire raw history." />
      <info label="Draft: numerical and schema checks are software evidence only. Native Android/iOS import, BLE acquisition and physical calibration still require validation. Export before using the app menu Clear data; it resets raw histories and edit defaults." />
    </view>
  </views>
  <export>
    <set name="Raw Nano mode 6">
      <data name="device_t (s)">device_t</data>
      <data name="receive_t (s)">receive_t</data>
      <data name="clear (counts)">clear</data>
      <data name="red (counts)">red</data>
      <data name="green (counts)">green</data>
      <data name="blue (counts)">blue</data>
    </set>
    <set name="Derived colour record">
      <data name="Device time (s)">device_t</data>
      <data name="Dark-corrected clear (counts)">clear_corrected</data>
      <data name="Red / clear corrected (1)">ratio_red</data>
      <data name="Green / clear corrected (1)">ratio_green</data>
      <data name="Blue / clear corrected (1)">ratio_blue</data>
      <data name="Provisional X (relative)">X</data>
      <data name="Provisional Y (relative)">Y</data>
      <data name="Provisional Z (relative)">Z</data>
      <data name="Provisional XYZ sum (relative)">xyz_sum</data>
      <data name="Chromaticity x (1)">chroma_x</data>
      <data name="Chromaticity y (1)">chroma_y</data>
      <data name="McCamy n (1)">n</data>
      <data name="Unvalidated polynomial candidate (K)">cct_candidate</data>
      <data name="Accepted indicative CCT (K)">cct</data>
    </set>
    <set name="Current settings (applied to whole derived record)">
      <data name="Colour calibration checked (0 or 1)">enabled</data>
      <data name="Count ceiling (screening only)">ceiling</data>
      <data name="Dark clear">dark_clear</data>
      <data name="Dark red">dark_red</data>
      <data name="Dark green">dark_green</data>
      <data name="Dark blue">dark_blue</data>
      <data name="X coefficient red">mXred</data>
      <data name="X coefficient green">mXgreen</data>
      <data name="X coefficient blue">mXblue</data>
      <data name="Y coefficient red">mYred</data>
      <data name="Y coefficient green">mYgreen</data>
      <data name="Y coefficient blue">mYblue</data>
      <data name="Z coefficient red">mZred</data>
      <data name="Z coefficient green">mZgreen</data>
      <data name="Z coefficient blue">mZblue</data>
    </set>
  </export>
</phyphox>
