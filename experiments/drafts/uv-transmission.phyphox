<?xml version="1.0" encoding="utf-8"?>
<!-- Original draft adaptation; source context and validation limits are in the companion manuscript. -->
<phyphox version="1.17" locale="en">
  <title>Draft: External UV detector transmission</title>
  <category>Curious Signals drafts</category>
  <description>Live Nano mode 9 A0 acquisition from an external appropriate analog UV detector. Captured sample/reference/dark ratios; absolute irradiance disabled until apparatus calibration is explicitly enabled. The APDS RGB sensor is not a UV detector.</description>
  <data-containers>
    <container size="1" init="0">id_in</container>
    <container size="0">id_row</container>
    <container size="1" init="0">reference_in</container>
    <container size="0">reference_row</container>
    <container size="1" init="0">dark_in</container>
    <container size="0">dark_row</container>
    <container size="1" init="0">paired_in</container>
    <container size="0">paired_row</container>
    <container size="1" init="0">adc_gain_in</container>
    <container size="0">adc_gain_row</container>
    <container size="1" init="0">adc_offset_in</container>
    <container size="0">adc_offset_row</container>
    <container size="1" init="0">adc_valid_in</container>
    <container size="0">adc_valid_row</container>
    <container size="1" init="0">uv_gain_in</container>
    <container size="0">uv_gain_row</container>
    <container size="1" init="0">absolute_in</container>
    <container size="0">absolute_row</container>
    <container size="0">device_t</container>
    <container size="0">receive_t</container>
    <container size="0">a0</container>
    <container size="0">a1</container>
    <container size="0">a2</container>
    <container size="0">sample_row</container>
    <container size="0">device_time_row</container>
    <container size="0">receive_time_row</container>
    <container size="1" init="NaN">current_a0</container>
    <container size="1" init="NaN">current_device_t</container>
    <container size="1" init="NaN">current_receive_t</container>
    <container size="1" init="0">record_request</container>
    <container size="1">a0_count</container>
    <container size="1">device_t_count</container>
    <container size="1">receive_t_count</container>
    <container size="0">transmission</container>
    <container size="0">transmission_calculation</container>
    <container size="0">sample_voltage</container>
    <container size="0">sample_voltage_calculation</container>
    <container size="0">dark_voltage</container>
    <container size="0">dark_voltage_calculation</container>
    <container size="0">irradiance</container>
    <container size="0">irradiance_calculation</container>
    <container size="1">id_pending</container>
    <container size="1">reference_pending</container>
    <container size="1">dark_pending</container>
    <container size="1">paired_pending</container>
    <container size="1">adc_gain_pending</container>
    <container size="1">adc_offset_pending</container>
    <container size="1">adc_valid_pending</container>
    <container size="1">uv_gain_pending</container>
    <container size="1">absolute_pending</container>
    <container size="1">sample_pending</container>
    <container size="1">device_time_pending</container>
    <container size="1">receive_time_pending</container>
    <container size="1">row_count</container>
  </data-containers>
  <input>
    <bluetooth name="phyphox-sense" id="Sense" mode="notification" rate="20" subscribeOnStart="false">
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">device_t</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">a0</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">a1</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">a2</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" extra="time">receive_t</output>
    </bluetooth>
  </input>
  <output>
    <bluetooth id="Sense">
      <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian">9</config>
    </bluetooth>
  </output>
  <views>
    <view label="Observe">
      <info label="Manual observation rows. Edit all paired values, then press Record row once. Wait for Recorded rows to increment before the next press. Saved inputs and settings are immutable until Clear rows. The app Clear data command also resets settings. No automatic physical validation." />
      <info label="Start to receive A0 counts from an external UV detector. Stop after a stable reading, then capture dark/reference and Record row. Paused Record uses the last received sample; check device time to avoid stale readings." />
      <value label="Latest A0" unit="count" precision="4">
        <input>current_a0</input>
      </value>
      <value label="Latest device time" unit="s" precision="4">
        <input>current_device_t</input>
      </value>
      <button label="Capture dark">
        <input>current_a0</input>
        <output>dark_in</output>
      </button>
      <button label="Capture reference">
        <input>current_a0</input>
        <output>reference_in</output>
      </button>
      <edit label="Observation ID" unit="" default="0" decimal="true" signed="true">
        <output>id_in</output>
      </edit>
      <edit label="Unfiltered reference" unit="count" default="0" decimal="true" signed="true">
        <output>reference_in</output>
      </edit>
      <edit label="Covered detector dark" unit="count" default="0" decimal="true" signed="true">
        <output>dark_in</output>
      </edit>
      <edit label="Paired linear readings checked (1=yes)" unit="" default="0" decimal="true" signed="true">
        <output>paired_in</output>
      </edit>
      <edit label="Measured ADC voltage gain" unit="V/count" default="0" decimal="true" signed="true">
        <output>adc_gain_in</output>
      </edit>
      <edit label="Measured ADC voltage offset" unit="V" default="0" decimal="true" signed="true">
        <output>adc_offset_in</output>
      </edit>
      <edit label="ADC calibration checked (1=yes)" unit="" default="0" decimal="true" signed="true">
        <output>adc_valid_in</output>
      </edit>
      <edit label="Measured detector irradiance gain" unit="W/m2/V" default="0" decimal="true" signed="true">
        <output>uv_gain_in</output>
      </edit>
      <edit label="Irradiance calibration checked (1=yes)" unit="" default="0" decimal="true" signed="true">
        <output>absolute_in</output>
      </edit>
      <button label="Record row">
        <input>id_in</input>
        <output>id_pending</output>
        <input>reference_in</input>
        <output>reference_pending</output>
        <input>dark_in</input>
        <output>dark_pending</output>
        <input>paired_in</input>
        <output>paired_pending</output>
        <input>adc_gain_in</input>
        <output>adc_gain_pending</output>
        <input>adc_offset_in</input>
        <output>adc_offset_pending</output>
        <input>adc_valid_in</input>
        <output>adc_valid_pending</output>
        <input>uv_gain_in</input>
        <output>uv_gain_pending</output>
        <input>absolute_in</input>
        <output>absolute_pending</output>
        <input>current_a0</input>
        <output>sample_pending</output>
        <input>current_device_t</input>
        <output>device_time_pending</output>
        <input>current_receive_t</input>
        <output>receive_time_pending</output>
        <input type="value">1</input>
        <output>record_request</output>
      </button>
      <button label="Clear rows">
        <input type="empty" />
        <output>id_row</output>
        <input type="empty" />
        <output>reference_row</output>
        <input type="empty" />
        <output>dark_row</output>
        <input type="empty" />
        <output>paired_row</output>
        <input type="empty" />
        <output>adc_gain_row</output>
        <input type="empty" />
        <output>adc_offset_row</output>
        <input type="empty" />
        <output>adc_valid_row</output>
        <input type="empty" />
        <output>uv_gain_row</output>
        <input type="empty" />
        <output>absolute_row</output>
        <input type="empty" />
        <output>sample_row</output>
        <input type="empty" />
        <output>device_time_row</output>
        <input type="empty" />
        <output>receive_time_row</output>
        <input type="empty" />
        <output>id_pending</output>
        <input type="empty" />
        <output>reference_pending</output>
        <input type="empty" />
        <output>dark_pending</output>
        <input type="empty" />
        <output>paired_pending</output>
        <input type="empty" />
        <output>adc_gain_pending</output>
        <input type="empty" />
        <output>adc_offset_pending</output>
        <input type="empty" />
        <output>adc_valid_pending</output>
        <input type="empty" />
        <output>uv_gain_pending</output>
        <input type="empty" />
        <output>absolute_pending</output>
        <input type="empty" />
        <output>sample_pending</output>
        <input type="empty" />
        <output>device_time_pending</output>
        <input type="empty" />
        <output>receive_time_pending</output>
        <input type="empty" />
        <output>transmission</output>
        <input type="empty" />
        <output>sample_voltage</output>
        <input type="empty" />
        <output>dark_voltage</output>
        <input type="empty" />
        <output>irradiance</output>
        <input type="empty" />
        <output>transmission_calculation</output>
        <input type="empty" />
        <output>sample_voltage_calculation</output>
        <input type="empty" />
        <output>dark_voltage_calculation</output>
        <input type="empty" />
        <output>irradiance_calculation</output>
        <input type="empty" />
        <output>row_count</output>
        <input type="value">0</input>
        <output>record_request</output>
      </button>
      <value label="Recorded rows" unit="" precision="4">
        <input>row_count</input>
      </value>
    </view>
    <view label="Results">
      <graph label="Captured UV transmission" labelX="Captured device time" labelY="Detector weighted transmission" unitX="s" unitY="" style="dots" partialUpdate="false">
        <input axis="x">device_time_row</input>
        <input axis="y">transmission</input>
      </graph>
      <graph label="Captured calibrated irradiance" labelX="Captured device time" labelY="Detector-band irradiance" unitX="s" unitY="W/m2" style="dots" partialUpdate="false">
        <input axis="x">device_time_row</input>
        <input axis="y">irradiance</input>
      </graph>
    </view>
    <view label="Setup">
      <info label="External analog UV detector with known spectral response and a documented linear output is REQUIRED. Connect conditioned signal to A0 and common ground. Verify at the terminal with a meter: 0 to 3.3 V only; no negative or 5 V signals. Never connect an unconditioned photodiode directly and assume calibration." />
      <info label="Use an approved enclosed classroom UV source and equipment controls; follow its operating instructions and avoid direct eye/skin exposure. Keep detector geometry fixed and check visible-light leakage, bandwidth, saturation and filter fluorescence. The built-in APDS RGB detector does not measure UV." />
      <info label="Start acquisition; cover the detector, wait for stability, Stop and Capture dark. Resume with no sample, settle, Stop and Capture reference. Resume with sample, settle and Stop. Set Paired linear readings checked to 1 only when source, geometry, detector gain and linearity match; Record row captures the latest A0, clocks and current settings." />
      <info label="Transmission uses (sample-dark)/(reference-dark) in ADC counts and requires in-range unsaturated counts, sample at least dark, and reference above dark. Below-dark samples or rail readings give gaps. More than unity is retained as a diagnostic. A capture can be stale: inspect the device time." />
      <info label="Absolute irradiance also requires positive measured ADC gain and detector irradiance gain, plus BOTH calibration checks at 1. Voltage = gain*count+offset must lie strictly within 0 to 3.3 V for sample and dark. Irradiance = detector gain*(sample voltage-dark voltage). No default coefficients are a measured calibration." />
      <info label="Clear rows removes captured observations only; raw acquisition remains. App Clear data removes all data and restores zero/default checks. Raw export preserves A0/A1/A2, device and receive clocks separately; they are not synchronized with external equipment. Test electrical limits, BLE and native app operation before use." />
    </view>
    <view label="Raw stream">
      <graph label="External UV detector A0 counts" labelX="Receive time" labelY="A0" unitX="s" unitY="count" partialUpdate="false">
        <input axis="x">receive_t</input>
        <input axis="y">a0</input>
      </graph>
    </view>
  </views>
  <analysis sleep="0.1" onUserInput="false">
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">id_pending</input>
      <output append="true">id_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">reference_pending</input>
      <output append="true">reference_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">dark_pending</input>
      <output append="true">dark_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">paired_pending</input>
      <output append="true">paired_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">adc_gain_pending</input>
      <output append="true">adc_gain_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">adc_offset_pending</input>
      <output append="true">adc_offset_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">adc_valid_pending</input>
      <output append="true">adc_valid_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">uv_gain_pending</input>
      <output append="true">uv_gain_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">absolute_pending</input>
      <output append="true">absolute_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">sample_pending</input>
      <output append="true">sample_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">device_time_pending</input>
      <output append="true">device_time_row</output>
    </if>
    <if equal="true">
      <input as="a" keep="true">record_request</input>
      <input as="b" type="value">1</input>
      <input as="true" keep="true">receive_time_pending</input>
      <output append="true">receive_time_row</output>
    </if>
    <append>
      <input type="value">0</input>
      <output append="false">record_request</output>
    </append>
    <!--Each derived calculation is filtered by x+0*x: finite values are unchanged; native IEEE infinities become NaN gaps.-->
    <count>
      <input keep="true">a0</input>
      <output append="false">a0_count</output>
    </count>
    <if greater="true">
      <input as="a" keep="true">a0_count</input>
      <input as="b" type="value">0</input>
      <input as="true" keep="true">a0</input>
      <input as="false" type="value">NaN</input>
      <output append="false">current_a0</output>
    </if>
    <count>
      <input keep="true">device_t</input>
      <output append="false">device_t_count</output>
    </count>
    <if greater="true">
      <input as="a" keep="true">device_t_count</input>
      <input as="b" type="value">0</input>
      <input as="true" keep="true">device_t</input>
      <input as="false" type="value">NaN</input>
      <output append="false">current_device_t</output>
    </if>
    <count>
      <input keep="true">receive_t</input>
      <output append="false">receive_t_count</output>
    </count>
    <if greater="true">
      <input as="a" keep="true">receive_t_count</input>
      <input as="b" type="value">0</input>
      <input as="true" keep="true">receive_t</input>
      <input as="false" type="value">NaN</input>
      <output append="false">current_receive_t</output>
    </if>
    <formula formula="([1_]-[3_])/(([2_]-[3_])*max(0,sign([1_]))*max(0,sign(1023-[1_]))*max(0,sign([2_]))*max(0,sign(1023-[2_]))*heaviside([3_])*max(0,sign(1023-[3_]))*heaviside([1_]-[3_])*max(0,sign([2_]-[3_]))*max(0,1-abs(sign([4_]-1))))">
      <input keep="true">sample_row</input>
      <input keep="true">reference_row</input>
      <input keep="true">dark_row</input>
      <input keep="true">paired_row</input>
      <output append="false">transmission_calculation</output>
    </formula>
    <formula formula="[1_]+0*[1_]">
      <input keep="true">transmission_calculation</input>
      <output append="false">transmission</output>
    </formula>
    <formula formula="([1_]*[2_]+[3_])/(max(0,sign([2_]))*max(0,1-abs(sign([4_]-1)))*max(0,sign([1_]))*max(0,sign(1023-[1_]))*max(0,sign([1_]*[2_]+[3_]))*max(0,sign(3.3-([1_]*[2_]+[3_]))))">
      <input keep="true">sample_row</input>
      <input keep="true">adc_gain_row</input>
      <input keep="true">adc_offset_row</input>
      <input keep="true">adc_valid_row</input>
      <output append="false">sample_voltage_calculation</output>
    </formula>
    <formula formula="[1_]+0*[1_]">
      <input keep="true">sample_voltage_calculation</input>
      <output append="false">sample_voltage</output>
    </formula>
    <formula formula="([1_]*[2_]+[3_])/(max(0,sign([2_]))*max(0,1-abs(sign([4_]-1)))*heaviside([1_])*max(0,sign(1023-[1_]))*max(0,sign([1_]*[2_]+[3_]))*max(0,sign(3.3-([1_]*[2_]+[3_]))))">
      <input keep="true">dark_row</input>
      <input keep="true">adc_gain_row</input>
      <input keep="true">adc_offset_row</input>
      <input keep="true">adc_valid_row</input>
      <output append="false">dark_voltage_calculation</output>
    </formula>
    <formula formula="[1_]+0*[1_]">
      <input keep="true">dark_voltage_calculation</input>
      <output append="false">dark_voltage</output>
    </formula>
    <formula formula="([1_]-[2_])*[3_]/(max(0,sign([1_]))*max(0,sign(3.3-[1_]))*max(0,sign([2_]))*max(0,sign(3.3-[2_]))*heaviside([1_]-[2_])*max(0,sign([3_]))*max(0,1-abs(sign([4_]-1)))*max(0,1-abs(sign([5_]-1)))*(1+0*[3_]))">
      <input keep="true">sample_voltage</input>
      <input keep="true">dark_voltage</input>
      <input keep="true">uv_gain_row</input>
      <input keep="true">absolute_row</input>
      <input keep="true">paired_row</input>
      <output append="false">irradiance_calculation</output>
    </formula>
    <formula formula="[1_]+0*[1_]">
      <input keep="true">irradiance_calculation</input>
      <output append="false">irradiance</output>
    </formula>
    <count>
      <input keep="true">id_row</input>
      <output append="false">row_count</output>
    </count>
  </analysis>
  <export>
    <set name="Captured observation rows">
      <data name="Observation ID">id_row</data>
      <data name="Unfiltered reference (count)">reference_row</data>
      <data name="Covered detector dark (count)">dark_row</data>
      <data name="Paired linear readings checked (1=yes)">paired_row</data>
      <data name="Measured ADC voltage gain (V/count)">adc_gain_row</data>
      <data name="Measured ADC voltage offset (V)">adc_offset_row</data>
      <data name="ADC calibration checked (1=yes)">adc_valid_row</data>
      <data name="Measured detector irradiance gain (W/m2/V)">uv_gain_row</data>
      <data name="Irradiance calibration checked (1=yes)">absolute_row</data>
      <data name="Captured A0 (count)">sample_row</data>
      <data name="Captured device time (s)">device_time_row</data>
      <data name="Captured receive time (s)">receive_time_row</data>
      <data name="UV detector weighted transmission">transmission</data>
      <data name="Calibrated sample voltage (V)">sample_voltage</data>
      <data name="Calibrated dark voltage (V)">dark_voltage</data>
      <data name="Calibrated detector-band irradiance (W/m2)">irradiance</data>
    </set>
    <set name="Current entry settings">
      <data name="Observation ID">id_in</data>
      <data name="Unfiltered reference (count)">reference_in</data>
      <data name="Covered detector dark (count)">dark_in</data>
      <data name="Paired linear readings checked (1=yes)">paired_in</data>
      <data name="Measured ADC voltage gain (V/count)">adc_gain_in</data>
      <data name="Measured ADC voltage offset (V)">adc_offset_in</data>
      <data name="ADC calibration checked (1=yes)">adc_valid_in</data>
      <data name="Measured detector irradiance gain (W/m2/V)">uv_gain_in</data>
      <data name="Irradiance calibration checked (1=yes)">absolute_in</data>
    </set>
    <set name="Raw analog acquisition">
      <data name="Device time (s)">device_t</data>
      <data name="Receive time (s)">receive_t</data>
      <data name="A0 (count)">a0</data>
      <data name="A1 (count)">a1</data>
      <data name="A2 (count)">a2</data>
    </set>
  </export>
</phyphox>
