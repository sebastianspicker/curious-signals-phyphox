<!-- Original Curious Signals draft; source context: docs/drafts/starspot-crossing.md. -->
<phyphox version="1.17" locale="en">
  <title>Draft: Starspot crossing contrast</title>
  <category>Curious Signals drafts</category>
  <description>Nano mode 6 photometry of an opaque planet crossing a dark patch on a luminous source. Compare manually selected adjacent and crossing window means; retain raw RGBC and independent device/receive timestamps.</description>
  <data-containers>
    <container size="0">device_time</container>
    <container size="0">receive_time</container>
    <container size="0">clear</container>
    <container size="0">red</container>
    <container size="0">green</container>
    <container size="0">blue</container>
    <container size="1" init="0">enabled</container>
    <container size="1" init="0">dark</container>
    <container size="1" init="0">baseline</container>
    <container size="1">den</container>
    <container size="0">normalized</container>
    <container size="1" init="0">adjacent_mean</container>
    <container size="1" init="0">crossing_mean</container>
    <container size="1">spot_contrast_candidate</container>
    <container size="1">spot_contrast_gated</container>
    <container size="1">spot_contrast</container>
  </data-containers>
  <input>
    <bluetooth id="Sense" name="phyphox-sense" mode="notification" subscribeOnStart="true">
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">device_time</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">clear</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">red</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">green</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">blue</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" extra="time">receive_time</output>
    </bluetooth>
  </input>
  <output>
    <bluetooth id="Sense" name="phyphox-sense">
      <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian">6</config>
    </bluetooth>
  </output>
  <analysis sleep="0.1">
    <formula formula="[1]-[2]">
      <input type="buffer" clear="false">baseline</input>
      <input type="buffer" clear="false">dark</input>
      <output clear="true">den</output>
    </formula>
    <formula formula="([1_]-[2])/([3]-[2])*((heaviside([3]-[2])*sign([3]-[2]))/(heaviside([3]-[2])*sign([3]-[2])))*((1-sign(abs([4]-1)))/(1-sign(abs([4]-1))))">
      <input type="buffer" clear="false">clear</input>
      <input type="buffer" clear="false">dark</input>
      <input type="buffer" clear="false">baseline</input>
      <input type="buffer" clear="false">enabled</input>
      <output clear="true">normalized</output>
    </formula>
    <formula formula="([1]-[2])/[3]">
      <input type="buffer" clear="false">crossing_mean</input>
      <input type="buffer" clear="false">adjacent_mean</input>
      <input type="buffer" clear="false">den</input>
      <output clear="true">spot_contrast_candidate</output>
    </formula>
    <formula formula="[1]*((heaviside([2])*sign([2]))/(heaviside([2])*sign([2])))*((1-sign(abs([3]-1)))/(1-sign(abs([3]-1))))">
      <input type="buffer" clear="false">spot_contrast_candidate</input>
      <input type="buffer" clear="false">den</input>
      <input type="buffer" clear="false">enabled</input>
      <output clear="true">spot_contrast_gated</output>
    </formula>
    <formula formula="[1]*((heaviside([2]-(0)))/(heaviside([2]-(0))))*((heaviside((1)-[3]))/(heaviside((1)-[3])))*((heaviside([4]-[6]))/(heaviside([4]-[6])))*((heaviside([7]-[5]))/(heaviside([7]-[5])))">
      <input type="buffer" clear="false">spot_contrast_gated</input>
      <input type="buffer" clear="false">spot_contrast_candidate</input>
      <input type="buffer" clear="false">spot_contrast_candidate</input>
      <output clear="true">spot_contrast</output>
      <input type="buffer" clear="false">adjacent_mean</input>
      <input type="buffer" clear="false">crossing_mean</input>
      <input type="buffer" clear="false">dark</input>
      <input type="buffer" clear="false">baseline</input>
    </formula>
  </analysis>
  <views>
    <view label="Acquisition">
      <graph label="Raw clear counts" labelX="Receive time" labelY="Clear counts" unitX="s" unitY="counts" partialUpdate="false" style="lines">
        <input axis="x">receive_time</input>
        <input axis="y">clear</input>
      </graph>
      <value label="Device time (separate clock)" unit="s" precision="4">
        <input>device_time</input>
      </value>
      <graph label="Normalized light curve" labelX="Receive time" labelY="Relative signal" unitX="s" unitY="1" partialUpdate="false" style="lines">
        <input axis="x">receive_time</input>
        <input axis="y">normalized</input>
      </graph>
    </view>
    <view label="Calibration">
      <edit label="Enable reduction (0 or 1)" default="0" signed="true" decimal="true" min="0" max="1">
        <output>enabled</output>
      </edit>
      <edit label="Dark/background mean" default="0" signed="true" decimal="true">
        <output>dark</output>
      </edit>
      <edit label="Unocculted baseline mean" default="0" signed="true" decimal="true">
        <output>baseline</output>
      </edit>
    </view>
    <view label="Characteristic means">
      <edit label="Adjacent transit plateau mean" default="0" signed="true" decimal="true">
        <output>adjacent_mean</output>
      </edit>
      <edit label="Spot-crossing mean" default="0" signed="true" decimal="true">
        <output>crossing_mean</output>
      </edit>
      <info>Enter means from settled adjacent transit windows and the spot-crossing window in counts, using this spotted-source baseline. Contrast=(crossing-adjacent)/(baseline-dark). Adjacent windows should bracket the anomaly and match projected planet area. Inspect drift and hardware shadows. Negative contrasts are unavailable under the upward-anomaly interpretation. Compute scatter and means from exported windows; compare no-patch control.</info>
      <value label="Local upward anomaly contrast" unit="1" precision="4">
        <input>spot_contrast</input>
      </value>
    </view>
    <view label="Setup">
      <info>Place a dark patch ON the emitting globe, then move an opaque planet over that patch. A planet hiding a darker source region can cause an upward anomaly. Compare no-patch, patch-without-planet, and crossing runs with matched geometry. The patch is a dim source surface, not a second foreground body. Do not infer a planet or spot radius from the total depth; nonuniform surface brightness violates the uniform-disk radius model. Source: AG2024 PDF physical p.32.</info>
      <info>Draft software only. Import, BLE delivery, Android/iOS button behavior and physical apparatus remain to be validated. Counts are not lux. Keep source geometry and spectral output fixed; test linearity and avoid clipping. Changing current settings recalculates the live curve; export before changing runs. Device seconds and receive seconds are independent clocks. Do not infer timing precision from nominal firmware rate.</info>
    </view>
  </views>
  <export>
    <set name="Raw Nano mode 6">
      <data name="receive_time">receive_time</data>
      <data name="device_time">device_time</data>
      <data name="clear">clear</data>
      <data name="red">red</data>
      <data name="green">green</data>
      <data name="blue">blue</data>
    </set>
    <set name="Current controls">
      <data name="enabled">enabled</data>
      <data name="dark">dark</data>
      <data name="baseline">baseline</data>
      <data name="adjacent_mean">adjacent_mean</data>
      <data name="crossing_mean">crossing_mean</data>
    </set>
    <set name="Reduction">
      <data name="normalized">normalized</data>
      <data name="spot_contrast">spot_contrast</data>
    </set>
  </export>
</phyphox>
