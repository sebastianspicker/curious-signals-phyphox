<?xml version='1.0' encoding='utf-8'?>
<phyphox version="1.17" locale="en">
  <!--Original Curious Signals optics draft; see companion manuscript for source anchors, method and limitations.-->
  <title>Draft: Relative light versus ruler distance</title>
  <category>Curious Signals drafts</category>
  <description>Acquire Nano mode 6 light while entering ruler distance manually. Record appends one settled light-and-distance observation with actual device and receive timestamps; Clear observations preserves the raw acquisition. Counts are not lux.</description>
  <icon>Opt</icon>
  <data-containers>
    <container size="0">device_t</container>
    <container size="0">clear</container>
    <container size="0">red</container>
    <container size="0">green</container>
    <container size="0">blue</container>
    <container size="0">receive_t</container>
    <container size="1" init="0">entered_distance</container>
    <container size="1" init="NaN">current_device_t</container>
    <container size="1" init="NaN">current_receive_t</container>
    <container size="1" init="NaN">current_clear</container>
    <container size="0">row_distance</container>
    <container size="0">row_device_t</container>
    <container size="0">row_receive_t</container>
    <container size="0">row_clear</container>
    <container size="1" init="0">background</container>
    <container size="1" init="4100">ceiling</container>
    <container size="0">corrected</container>
    <container size="0">valid_distance</container>
    <container size="0">inverse_square</container>
    <container size="0">scaled_light</container>
    <container size="0">log_distance</container>
    <container size="0">log_light</container>
    <container size="1" init="1">sentinel</container>
    <container size="1" init="0">record_request</container>
    <container size="1" init="NaN">pending_row_distance</container>
    <container size="1" init="NaN">pending_row_device_t</container>
    <container size="1" init="NaN">pending_row_receive_t</container>
    <container size="1" init="NaN">pending_row_clear</container>
  </data-containers>
  <input>
    <bluetooth name="phyphox-sense" id="Sense" mode="notification" subscribeOnStart="false">
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">device_t</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">clear</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">red</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">green</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">blue</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" extra="time">receive_t</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">current_device_t</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" extra="time">current_receive_t</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">current_clear</output>
    </bluetooth>
  </input>
  <output>
    <bluetooth id="Sense">
      <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian">6</config>
    </bluetooth>
  </output>
  <analysis sleep="0.1" onUserInput="false">
    <if equal="true">
      <input as="a" type="buffer" clear="false">record_request</input>
      <input as="b" type="value" clear="false">1</input>
      <input as="true" type="buffer" clear="false">pending_row_distance</input>
      <output clear="false">row_distance</output>
    </if>
    <if equal="true">
      <input as="a" type="buffer" clear="false">record_request</input>
      <input as="b" type="value" clear="false">1</input>
      <input as="true" type="buffer" clear="false">pending_row_device_t</input>
      <output clear="false">row_device_t</output>
    </if>
    <if equal="true">
      <input as="a" type="buffer" clear="false">record_request</input>
      <input as="b" type="value" clear="false">1</input>
      <input as="true" type="buffer" clear="false">pending_row_receive_t</input>
      <output clear="false">row_receive_t</output>
    </if>
    <if equal="true">
      <input as="a" type="buffer" clear="false">record_request</input>
      <input as="b" type="value" clear="false">1</input>
      <input as="true" type="buffer" clear="false">pending_row_clear</input>
      <output clear="false">row_clear</output>
    </if>
    <formula formula="[1]*0">
      <input clear="false">sentinel</input>
      <output clear="true">record_request</output>
    </formula>
    <formula formula="([1_]-[2])/((heaviside([1_]-[2])/heaviside([1_]-[2]))*(max(0,sign([3]-[1_]))/max(0,sign([3]-[1_]))))">
      <input clear="false">row_clear</input>
      <input clear="false">background</input>
      <input clear="false">ceiling</input>
      <output clear="true">corrected</output>
    </formula>
    <formula formula="[1_]/(max(0,sign([1_]))/max(0,sign([1_])))">
      <input clear="false">row_distance</input>
      <output clear="true">valid_distance</output>
    </formula>
    <formula formula="1/[1_]^2">
      <input clear="false">valid_distance</input>
      <output clear="true">inverse_square</output>
    </formula>
    <formula formula="[1_]*[2_]^2">
      <input clear="false">corrected</input>
      <input clear="false">valid_distance</input>
      <output clear="true">scaled_light</output>
    </formula>
    <formula formula="log([1_])">
      <input clear="false">valid_distance</input>
      <output clear="true">log_distance</output>
    </formula>
    <formula formula="log([1_])/(max(0,sign([1_]))/max(0,sign([1_])))">
      <input clear="false">corrected</input>
      <output clear="true">log_light</output>
    </formula>
  </analysis>
  <views>
    <view label="Record observations">
      <edit label="Ruler source-to-aperture distance" default="0" unit="m" signed="true" decimal="true">
        <output>entered_distance</output>
      </edit>
      <value label="Live clear counts" unit="counts" precision="4">
        <input>clear</input>
      </value>
      <button label="Record">
        <input type="buffer">entered_distance</input>
        <output clear="true">pending_row_distance</output>
        <input type="buffer">current_device_t</input>
        <output clear="true">pending_row_device_t</output>
        <input type="buffer">current_receive_t</input>
        <output clear="true">pending_row_receive_t</output>
        <input type="buffer">current_clear</input>
        <output clear="true">pending_row_clear</output>
        <input type="value">1</input>
        <output clear="true">record_request</output>
      </button>
      <button label="Clear observations">
        <input type="empty" />
        <output clear="true">row_distance</output>
        <input type="empty" />
        <output clear="true">row_device_t</output>
        <input type="empty" />
        <output clear="true">row_receive_t</output>
        <input type="empty" />
        <output clear="true">row_clear</output>
        <input type="value">0</input>
        <output clear="true">record_request</output>
      </button>
      <graph label="Settled observations" labelX="Ruler distance" labelY="Signal" unitX="m" unitY="counts" partialUpdate="false" style="dots">
        <input axis="x">valid_distance</input>
        <input axis="y">corrected</input>
      </graph>
      <graph label="Inverse-square comparison" labelX="Inverse square distance" labelY="Signal" unitX="1/m²" unitY="counts" partialUpdate="false" style="dots">
        <input axis="x">inverse_square</input>
        <input axis="y">corrected</input>
      </graph>
      <graph label="Log comparison (slope expected -2)" labelX="ln(r / m)" labelY="ln(signal / count)" unitX="1" unitY="1" partialUpdate="false" style="dots">
        <input axis="x">log_distance</input>
        <input axis="y">log_light</input>
      </graph>
      <info label="Start acquisition, stop the rail, wait for several stable reports, enter the measured distance and press Record once. Capture uses singleton values from the latest acquired BLE notification. Pausing then recording captures the last measured sample, not a fresh measurement. Before acquisition, rows may contain unavailable data; exclude them using the exported clocks. Clear observations removes all paired rows; app Clear data also clears raw histories." />
    </view>
    <view label="Calibration">
      <edit label="Lamp-off background" default="0" unit="counts" signed="true" decimal="true">
        <output>background</output>
      </edit>
      <edit label="Count ceiling (screening only)" default="4100" unit="counts" signed="true" decimal="true" min="1">
        <output>ceiling</output>
      </edit>
    </view>
    <view label="Setup">
      <info label="Mount original Nano 33 BLE Sense APDS-9960 on a ruler rail facing a stable small lamp. Current firmware supplies mode 6; this variant needs no HID mouse. Measure actual source centre to sensor aperture. Keep alignment and gain fixed." />
      <info label="At each positive distance, settle, enter Ruler source-to-aperture distance, and press Record. Repeat positions in reverse order. Measure background with lamp off and enter its mean. Current background and ceiling recalculate all observations. Counts are relative light, not calibrated illuminance." />
      <info label="Compare corrected light with 1/r² and look for near-constant signal times r². Finite lamp size, reflections, offset errors and changing ambient light can dominate the result. There is no automatic distance measurement in this variant." />
      <info label="Draft: numerical and schema checks are software evidence only. Native Android/iOS import, BLE acquisition and physical calibration still require validation. Export before using the app menu Clear data; it resets raw histories and edit defaults." />
    </view>
  </views>
  <export>
    <set name="Raw Nano mode 6">
      <data name="device_t (s)">device_t</data>
      <data name="receive_t (s)">receive_t</data>
      <data name="clear (counts)">clear</data>
      <data name="red (counts)">red</data>
      <data name="green (counts)">green</data>
      <data name="blue (counts)">blue</data>
    </set>
    <set name="Paired manual ruler observations">
      <data name="Entered ruler distance (m)">row_distance</data>
      <data name="Captured device time (s)">row_device_t</data>
      <data name="Captured receive time (s)">row_receive_t</data>
      <data name="Captured clear signal (counts)">row_clear</data>
      <data name="Background-corrected signal (counts)">corrected</data>
      <data name="Positive ruler distance (m)">valid_distance</data>
      <data name="Inverse square distance (1/m²)">inverse_square</data>
      <data name="Corrected signal times distance squared (count m²)">scaled_light</data>
      <data name="ln(distance / m)">log_distance</data>
      <data name="ln(corrected signal / count)">log_light</data>
    </set>
    <set name="Current settings (applied to whole derived record)">
      <data name="Ruler source-to-aperture distance">entered_distance</data>
      <data name="Lamp-off background">background</data>
      <data name="Count ceiling (screening only)">ceiling</data>
    </set>
  </export>
</phyphox>