<?xml version='1.0' encoding='utf-8'?>
<phyphox version="1.17" locale="en">
  <!--Original Curious Signals optics draft; see companion manuscript for source anchors, method and limitations.-->
  <title>Draft: Detector sampling and detectability</title>
  <category>Curious Signals drafts</category>
  <description>Acquire Nano mode 6 raw light and measured device/receive clocks. Inspect actual inter-sample intervals, select a baseline interval, and estimate baseline noise, expected single-sample SNR and samples per proposed feature.</description>
  <icon>Opt</icon>
  <data-containers>
    <container size="0">device_t</container>
    <container size="0">clear</container>
    <container size="0">red</container>
    <container size="0">green</container>
    <container size="0">blue</container>
    <container size="0">receive_t</container>
    <container size="0">dt_device_t</container>
    <container size="0">dt_receive_t</container>
    <container size="0">rate_device_t</container>
    <container size="0">mean_dt_device_t</container>
    <container size="0">jitter_device_t</container>
    <container size="1">mean_rate_device_t</container>
    <container size="0">rate_receive_t</container>
    <container size="0">mean_dt_receive_t</container>
    <container size="0">jitter_receive_t</container>
    <container size="1">mean_rate_receive_t</container>
    <container size="1" init="0">baseline_start</container>
    <container size="1" init="10">baseline_end</container>
    <container size="1" init="0">dark</container>
    <container size="1" init="0.01">depth</container>
    <container size="1" init="1">duration</container>
    <container size="0">baseline_t</container>
    <container size="0">baseline_clear</container>
    <container size="0">baseline_mean</container>
    <container size="0">baseline_sd</container>
    <container size="0">baseline_count</container>
    <container size="1">expected_drop</container>
    <container size="1">snr</container>
    <container size="1">samples_per_feature</container>
    <container size="1">min_dt_device_t</container>
    <container size="1">min_dt_receive_t</container>
  </data-containers>
  <input>
    <bluetooth name="phyphox-sense" id="Sense" mode="notification" subscribeOnStart="false">
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="0">device_t</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="4">clear</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="8">red</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="12">green</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian" offset="16">blue</output>
      <output char="cddf1002-30f7-4671-8b43-5e40ba53514a" extra="time">receive_t</output>
    </bluetooth>
  </input>
  <output>
    <bluetooth id="Sense">
      <config char="cddf1003-30f7-4671-8b43-5e40ba53514a" conversion="float32LittleEndian">6</config>
    </bluetooth>
  </output>
  <analysis sleep="0.1" onUserInput="false">
    <differentiate>
      <input as="in" clear="false">device_t</input>
      <output as="out" clear="true">dt_device_t</output>
    </differentiate>
    <differentiate>
      <input as="in" clear="false">receive_t</input>
      <output as="out" clear="true">dt_receive_t</output>
    </differentiate>
    <formula formula="1/[1_]/(max(0,sign([1_]))/max(0,sign([1_])))">
      <input clear="false">dt_device_t</input>
      <output clear="true">rate_device_t</output>
    </formula>
    <average>
      <input as="buffer" clear="false">dt_device_t</input>
      <output as="average" clear="true">mean_dt_device_t</output>
      <output as="stddev" clear="true">jitter_device_t</output>
    </average>
    <min>
      <input as="y" clear="false">dt_device_t</input>
      <output as="min" clear="true">min_dt_device_t</output>
    </min>
    <formula formula="1/[1]/((max(0,sign([1]))/max(0,sign([1])))*(max(0,sign([2]))/max(0,sign([2]))))">
      <input clear="false">mean_dt_device_t</input>
      <output clear="true">mean_rate_device_t</output>
      <input clear="false">min_dt_device_t</input>
    </formula>
    <formula formula="1/[1_]/(max(0,sign([1_]))/max(0,sign([1_])))">
      <input clear="false">dt_receive_t</input>
      <output clear="true">rate_receive_t</output>
    </formula>
    <average>
      <input as="buffer" clear="false">dt_receive_t</input>
      <output as="average" clear="true">mean_dt_receive_t</output>
      <output as="stddev" clear="true">jitter_receive_t</output>
    </average>
    <min>
      <input as="y" clear="false">dt_receive_t</input>
      <output as="min" clear="true">min_dt_receive_t</output>
    </min>
    <formula formula="1/[1]/((max(0,sign([1]))/max(0,sign([1])))*(max(0,sign([2]))/max(0,sign([2]))))">
      <input clear="false">mean_dt_receive_t</input>
      <output clear="true">mean_rate_receive_t</output>
      <input clear="false">min_dt_receive_t</input>
    </formula>
    <rangefilter>
      <input as="in" clear="false">device_t</input>
      <input as="min" clear="false">baseline_start</input>
      <input as="max" clear="false">baseline_end</input>
      <input as="in" clear="false">clear</input>
      <output as="out" clear="true">baseline_t</output>
      <output as="out" clear="true">baseline_clear</output>
    </rangefilter>
    <average>
      <input as="buffer" clear="false">baseline_clear</input>
      <output as="average" clear="true">baseline_mean</output>
      <output as="stddev" clear="true">baseline_sd</output>
    </average>
    <count>
      <input as="buffer" clear="false">baseline_clear</input>
      <output as="count" clear="true">baseline_count</output>
    </count>
    <formula formula="([1]-[2])*[3]/((max(0,sign([1]-[2]))/max(0,sign([1]-[2])))*(max(0,sign([3]))/max(0,sign([3])))*(heaviside(1-[3])/heaviside(1-[3])))">
      <input clear="false">baseline_mean</input>
      <input clear="false">dark</input>
      <input clear="false">depth</input>
      <output clear="true">expected_drop</output>
    </formula>
    <formula formula="[1]/[2]/((max(0,sign([2]))/max(0,sign([2])))*(max(0,sign([3]-1))/max(0,sign([3]-1))))">
      <input clear="false">expected_drop</input>
      <input clear="false">baseline_sd</input>
      <output clear="true">snr</output>
      <input clear="false">baseline_count</input>
    </formula>
    <formula formula="[1]*[2]/(max(0,sign([1]))/max(0,sign([1])))">
      <input clear="false">duration</input>
      <input clear="false">mean_rate_device_t</input>
      <output clear="true">samples_per_feature</output>
    </formula>
  </analysis>
  <views>
    <view label="Sampling">
      <graph label="device consecutive intervals" labelX="Interval index" labelY="Measured interval" unitX="" unitY="s" partialUpdate="false" style="lines">
        <input axis="y">dt_device_t</input>
      </graph>
      <value label="Device mean delivered rate" unit="Hz" precision="4">
        <input>mean_rate_device_t</input>
      </value>
      <graph label="receive consecutive intervals" labelX="Interval index" labelY="Measured interval" unitX="" unitY="s" partialUpdate="false" style="lines">
        <input axis="y">dt_receive_t</input>
      </graph>
      <value label="Receive mean delivered rate" unit="Hz" precision="4">
        <input>mean_rate_receive_t</input>
      </value>
      <graph label="Raw clear history" labelX="Time" labelY="Signal" unitX="s" unitY="counts" partialUpdate="false" style="lines">
        <input axis="x">device_t</input>
        <input axis="y">clear</input>
      </graph>
    </view>
    <view label="Baseline and feature">
      <edit label="Baseline start (device clock)" default="0" unit="s" signed="true" decimal="true">
        <output>baseline_start</output>
      </edit>
      <edit label="Baseline end (device clock)" default="10" unit="s" signed="true" decimal="true">
        <output>baseline_end</output>
      </edit>
      <edit label="Covered-detector dark mean" default="0" unit="counts" signed="true" decimal="true">
        <output>dark</output>
      </edit>
      <edit label="Proposed fractional signal depth" default="0.01" unit="1" signed="true" decimal="true">
        <output>depth</output>
      </edit>
      <edit label="Proposed feature duration" default="1" unit="s" signed="true" decimal="true">
        <output>duration</output>
      </edit>
      <value label="Selected baseline sample count" unit="1" precision="4">
        <input>baseline_count</input>
      </value>
      <value label="Baseline mean" unit="counts" precision="4">
        <input>baseline_mean</input>
      </value>
      <value label="Baseline sample standard deviation" unit="counts" precision="4">
        <input>baseline_sd</input>
      </value>
      <value label="Expected signal drop" unit="counts" precision="4">
        <input>expected_drop</input>
      </value>
      <value label="Expected single-sample SNR" unit="1" precision="4">
        <input>snr</input>
      </value>
      <value label="Mean samples per proposed feature" unit="1" precision="4">
        <input>samples_per_feature</input>
      </value>
      <info label="Choose a stable baseline by actual device-clock start/end. Standard deviation is descriptive sample noise, not independent-sample uncertainty. A zero-noise, missing, or one-point baseline cannot yield a valid SNR. Set dark from a covered-sensor record; depth and duration are proposed test parameters, not fitted detections." />
    </view>
    <view label="Setup">
      <info label="Fix original Nano 33 BLE Sense APDS-9960 facing a steady source and acquire mode 6. Keep geometry and gain fixed. Record covered dark, stable illuminated baseline, then a slowly moved opaque edge or model transit at several speeds." />
      <info label="Actual consecutive device and app receive intervals are shown against interval index (not fabricated time). Device timing includes firmware scheduling; receive timing also includes BLE/app delivery. A restart/backwards or duplicate clock interval invalidates its reciprocal. Clear between clock resets and pauses before interpreting full-record means." />
      <info label="Mean delivered rate is 1/mean measured interval, not the sensor-chip specification. Long gaps, jitter and repeated values can matter even when mean rate looks adequate. The 50 ms firmware floor is not a bandwidth guarantee. Keep raw exports to inspect intervals and clipping." />
      <info label="Expected drop=depth*(baseline-dark); SNR=drop/baseline sample SD. Samples per feature=duration/mean device interval. Neither number establishes detection: ingress shape, drift, correlated noise, aliasing, exposure integration and phase can hide a feature. Compare repeated real waveforms and slow the model until the feature is resolved." />
      <info label="Draft: numerical and schema checks are software evidence only. Native Android/iOS import, BLE acquisition and physical calibration still require validation. Export before using the app menu Clear data; it resets raw histories and edit defaults." />
    </view>
  </views>
  <export>
    <set name="Raw Nano mode 6">
      <data name="device_t (s)">device_t</data>
      <data name="receive_t (s)">receive_t</data>
      <data name="clear (counts)">clear</data>
      <data name="red (counts)">red</data>
      <data name="green (counts)">green</data>
      <data name="blue (counts)">blue</data>
    </set>
    <set name="Measured intervals (N-1 rows)">
      <data name="Consecutive device interval (s)">dt_device_t</data>
      <data name="Consecutive receive interval (s)">dt_receive_t</data>
      <data name="Reciprocal device interval (Hz)">rate_device_t</data>
      <data name="Reciprocal receive interval (Hz)">rate_receive_t</data>
    </set>
    <set name="Selected baseline">
      <data name="Selected baseline device time (s)">baseline_t</data>
      <data name="Selected baseline clear (counts)">baseline_clear</data>
    </set>
    <set name="Summary">
      <data name="Mean device interval (s)">mean_dt_device_t</data>
      <data name="Mean receive interval (s)">mean_dt_receive_t</data>
      <data name="Device interval sample SD (s)">jitter_device_t</data>
      <data name="Receive interval sample SD (s)">jitter_receive_t</data>
      <data name="Mean delivered device rate (Hz)">mean_rate_device_t</data>
      <data name="Mean delivered receive rate (Hz)">mean_rate_receive_t</data>
      <data name="Selected baseline count (1)">baseline_count</data>
      <data name="Baseline mean (counts)">baseline_mean</data>
      <data name="Baseline sample SD (counts)">baseline_sd</data>
      <data name="Proposed signal drop (counts)">expected_drop</data>
      <data name="Expected single-sample SNR (1)">snr</data>
      <data name="Mean samples per feature (1)">samples_per_feature</data>
    </set>
    <set name="Current settings (applied to whole derived record)">
      <data name="Baseline start (device clock)">baseline_start</data>
      <data name="Baseline end (device clock)">baseline_end</data>
      <data name="Covered-detector dark mean">dark</data>
      <data name="Proposed fractional signal depth">depth</data>
      <data name="Proposed feature duration">duration</data>
    </set>
  </export>
</phyphox>