<phyphox version="1.7" locale="en">
    <title>Digital Multimeter</title>
    <category>Owon</category>
    <description>Debug utility for reading out Owon digital multimeters via phyphox. This file is an instrument helper and not an astronomy teaching experiment.</description>
    <translations>
  <translation locale="de">
    <title>Digitalmultimeter</title>
    <category>Owon</category>
    <description>Debug-Hilfsdatei zum Auslesen von Owon-Digitalmultimetern über phyphox. Diese Datei ist ein Instrumentenhelfer und kein Astronomie-Unterrichtsexperiment.</description>
    <string original="Value">Wert</string>
    <string original="Since the mode dial of the multimeter can be changed any time, we cannot show the correct units here. They always match the base units of the used mode (i.e. volt for voltage, not milli volts).">Da der Moduswahlschalter des Multimeters jederzeit geändert werden kann, können hier keine korrekten Einheiten angezeigt werden. Sie entsprechen immer den Basiseinheiten des verwendeten Modus (also Volt für Spannung, nicht Millivolt).</string>
    <string original="Raw Data">Rohdaten</string>
    <string original="Time (s)">Zeit (s)</string>
    <string original="Setup">Aufbau</string>
    <string original="Calibration">Kalibrierung</string>
    <string original="Full-record contrast">Kontrast der gesamten Messung</string>
    <string original="Use entered means (0 or 1)">Eingegebene Mittelwerte nutzen (0 oder 1)</string>
    <string original="Dark/background mean">Dunkel-/Hintergrundmittelwert</string>
    <string original="Reference mean">Referenzmittelwert</string>
    <string original="Sample mean">Probenmittelwert</string>
    <string original="Relative reflectance">Relativer Reflexionsfaktor</string>
    <string original="Signal source (1 phone, 2 SensorTag, 3 Owon)">Signalquelle (1 Telefon, 2 SensorTag, 3 Owon)</string>
    <string original="Owon model (1 B35T, 2 W18B)">Owon-Modell (1 B35T, 2 W18B)</string>
    <string original="Baseline mean">Basislinienmittelwert</string>
    <string original="Transit plateau mean">Mittelwert des Transitplateaus</string>
    <string original="Distance ratio dp/ds">Abstandsverhältnis dp/ds</string>
    <string original="Local transit depth">Lokale Transittiefe</string>
    <string original="Complete events">Vollständige Ereignisse</string>
    <string original="Mean threshold duration">Mittlere Schwellwertdauer</string>
    <string original="Mean onset period">Mittlere Eintrittsperiode</string>
    <string original="Lower normalized threshold">Untere normierte Schwelle</string>
    <string original="Upper normalized threshold">Obere normierte Schwelle</string>
    <string original="Normalized signal">Normiertes Signal</string>
    <string original="Detector die temperature">Sensortemperatur</string>
    <string original="Distance origin">Abstandsursprung</string>
    <string original="Distance scale">Abstandsskala</string>
    <string original="Calibrated distance">Kalibrierter Abstand</string>
    <string original="Choose the actual meter model before interpreting a trace. Unknown B35T decimal or unit codes produce gaps. W18B decoding is provisional and needs known positive and negative packet tests on the actual meter.">Vor der Auswertung das tatsächliche Multimetermodell wählen. Unbekannte B35T-Dezimal- oder Einheitencodes erzeugen Lücken. Die vorläufige W18B-Dekodierung muss am Gerät mit bekannten positiven und negativen Werten geprüft werden.</string>
    <string original="Keep the meter mode fixed throughout one run and verify the indicated base unit against the display. Record a stable reference, zero and a reversed polarity where appropriate. Exported raw fields preserve the decoder evidence. Receive timestamps measure packet arrival, not the meter conversion instant.">Den Messmodus während eines Laufs beibehalten und die Basiseinheit am Display prüfen. Eine stabile Referenz, Nullpunkt und gegebenenfalls umgekehrte Polarität messen. Exportierte Rohfelder bewahren die Dekodiergrundlage. Zeitstempel kennzeichnen die Paketankunft, nicht den Wandlungszeitpunkt.</string>
  </translation>
  <translation locale="fr">
    <title>Multimètre numérique</title>
    <category>Owon</category>
    <description>Utilitaire de débogage pour lire les multimètres numériques Owon via phyphox. Ce fichier est un outil pour instrument et non une expérience d'astronomie pédagogique.</description>
    <string original="Value">Valeur</string>
    <string original="Since the mode dial of the multimeter can be changed any time, we cannot show the correct units here. They always match the base units of the used mode (i.e. volt for voltage, not milli volts).">Comme la molette de mode du multimètre peut être changée à tout moment, nous ne pouvons pas afficher ici les unités correctes. Elles correspondent toujours aux unités de base du mode utilisé (par exemple volt pour une tension, et non millivolt).</string>
    <string original="Raw Data">Données brutes</string>
    <string original="Time (s)">Temps (s)</string>
    <string original="Setup">Montage</string>
    <string original="Calibration">Étalonnage</string>
    <string original="Full-record contrast">Contraste sur tout le relevé</string>
    <string original="Use entered means (0 or 1)">Utiliser les moyennes saisies (0 ou 1)</string>
    <string original="Dark/background mean">Moyenne sombre/fond</string>
    <string original="Reference mean">Moyenne de référence</string>
    <string original="Sample mean">Moyenne de l’échantillon</string>
    <string original="Relative reflectance">Réflectance relative</string>
    <string original="Signal source (1 phone, 2 SensorTag, 3 Owon)">Source (1 téléphone, 2 SensorTag, 3 Owon)</string>
    <string original="Owon model (1 B35T, 2 W18B)">Modèle Owon (1 B35T, 2 W18B)</string>
    <string original="Baseline mean">Moyenne hors transit</string>
    <string original="Transit plateau mean">Moyenne du plateau du transit</string>
    <string original="Distance ratio dp/ds">Rapport des distances dp/ds</string>
    <string original="Local transit depth">Profondeur locale du transit</string>
    <string original="Complete events">Événements complets</string>
    <string original="Mean threshold duration">Durée moyenne entre seuils</string>
    <string original="Mean onset period">Période moyenne des débuts</string>
    <string original="Lower normalized threshold">Seuil normalisé inférieur</string>
    <string original="Upper normalized threshold">Seuil normalisé supérieur</string>
    <string original="Normalized signal">Signal normalisé</string>
    <string original="Detector die temperature">Température de la puce du détecteur</string>
    <string original="Distance origin">Origine de la distance</string>
    <string original="Distance scale">Échelle de distance</string>
    <string original="Calibrated distance">Distance étalonnée</string>
    <string original="Choose the actual meter model before interpreting a trace. Unknown B35T decimal or unit codes produce gaps. W18B decoding is provisional and needs known positive and negative packet tests on the actual meter.">Choisir le modèle réel avant toute interprétation. Les codes décimaux ou d’unité B35T inconnus donnent des lacunes. Le décodage W18B est provisoire et exige des essais avec des valeurs positives et négatives connues sur l’appareil réel.</string>
    <string original="Keep the meter mode fixed throughout one run and verify the indicated base unit against the display. Record a stable reference, zero and a reversed polarity where appropriate. Exported raw fields preserve the decoder evidence. Receive timestamps measure packet arrival, not the meter conversion instant.">Conserver le mode pendant une mesure et vérifier l’unité de base sur l’afficheur. Mesurer une référence stable, le zéro et, si approprié, la polarité inversée. Les champs bruts exportés conservent les éléments du décodage. Les horodatages indiquent la réception, pas l’instant de conversion.</string>
  </translation>
</translations>

    <data-containers>
  <container size="0">tin</container>
  <container size="0">str</container>
  <container size="0">dec</container>
  <container size="0">unit</container>
  <container size="0">18value</container>
  <container size="0">18bitmask</container>
  <container size="0">b35_value</container>
  <container size="0">w18_value</container>
  <container size="0">meter_candidate</container>
  <container size="0">meter_invalid</container>
  <container size="0">decfac</container>
  <container size="0">unitfac</container>
  <container size="0">18signedvalue</container>
  <container size="0">18decfac</container>
  <container size="0">18prefac</container>
  <container size="0">V</container>
  <container size="0">t</container>
  <container size="1">meter_model</container>
</data-containers>
    <input>
  <bluetooth name="BDM" mode="notification">
    <output char="0000FFF4-0000-1000-8000-00805F9B34FB" conversion="string" length="5">str</output>
    <output char="0000FFF4-0000-1000-8000-00805F9B34FB" conversion="string" offset="6" length="1">dec</output>
    <output char="0000FFF4-0000-1000-8000-00805F9B34FB" conversion="uInt8" offset="9" length="1">unit</output>
    <output char="0000FFF4-0000-1000-8000-00805F9B34FB" conversion="uInt16LittleEndian" offset="4" length="2">18value</output>
    <output char="0000FFF4-0000-1000-8000-00805F9B34FB" conversion="uInt8" offset="0" length="1">18bitmask</output>
    <output char="0000FFF4-0000-1000-8000-00805F9B34FB" extra="time">tin</output>
  </bluetooth>
</input>
    <analysis sleep="0.05">
  <formula formula="((1-sign(abs([1_]-0)))*1+(1-sign(abs([1_]-1)))*0.001+(1-sign(abs([1_]-2)))*0.01+(1-sign(abs([1_]-4)))*0.1)/((1-sign(abs([1_]-0)))+(1-sign(abs([1_]-1)))+(1-sign(abs([1_]-2)))+(1-sign(abs([1_]-4))))">
    <input clear="false" type="buffer">dec</input>
    <output clear="true">decfac</output>
  </formula>
  <formula formula="((1-sign(abs([1_]-0)))*1+(1-sign(abs([1_]-16)))*1000000.0+(1-sign(abs([1_]-32)))*1000.0+(1-sign(abs([1_]-64)))*0.001+(1-sign(abs([1_]-128)))*1e-06)/((1-sign(abs([1_]-0)))+(1-sign(abs([1_]-16)))+(1-sign(abs([1_]-32)))+(1-sign(abs([1_]-64)))+(1-sign(abs([1_]-128))))">
    <input clear="false" type="buffer">unit</input>
    <output clear="true">unitfac</output>
  </formula>
  <formula formula="[1_]*[2_]*[3_]">
    <input clear="false" type="buffer">str</input>
    <input clear="false" type="buffer">decfac</input>
    <input clear="false" type="buffer">unitfac</input>
    <output clear="true">b35_value</output>
  </formula>
  <formula formula="([1_]%32768)*(1-2*floor([1_]/32768))">
    <input clear="false" type="buffer">18value</input>
    <output clear="true">18signedvalue</output>
  </formula>
  <formula formula="10^(-([1_]%4))">
    <input clear="false" type="buffer">18bitmask</input>
    <output clear="true">18decfac</output>
  </formula>
  <formula formula="1000^(floor([1_]/8)%8-4)">
    <input clear="false" type="buffer">18bitmask</input>
    <output clear="true">18prefac</output>
  </formula>
  <formula formula="[1_]*[2_]*[3_]">
    <input clear="false" type="buffer">18signedvalue</input>
    <input clear="false" type="buffer">18decfac</input>
    <input clear="false" type="buffer">18prefac</input>
    <output clear="true">w18_value</output>
  </formula>
  <formula formula="[1_]*0/0">
    <input clear="false" type="buffer">tin</input>
    <output clear="true">meter_invalid</output>
  </formula>
  <if equal="true">
    <input clear="false" type="buffer" as="a">meter_model</input>
    <input clear="false" type="value" as="b">2</input>
    <input clear="false" type="buffer" as="true">w18_value</input>
    <input clear="false" type="buffer" as="false">meter_invalid</input>
    <output clear="true">meter_candidate</output>
  </if>
  <if equal="true">
    <input clear="false" type="buffer" as="a">meter_model</input>
    <input clear="false" type="value" as="b">1</input>
    <input clear="false" type="buffer" as="true">b35_value</input>
    <input clear="false" type="buffer" as="false">meter_candidate</input>
    <output clear="true">V</output>
  </if>
  <append>
    <input clear="false" type="buffer">tin</input>
    <output clear="true">t</output>
  </append>
</analysis>
    <views>
  <view label="Value">
    <edit label="Owon model (1 B35T, 2 W18B)" default="1" decimal="false" signed="true" min="1" max="2">
      <output>meter_model</output>
    </edit>
    <graph label="Value" labelX="t" labelY="y" unitX="s" unitY="?" partialUpdate="false">
      <input axis="x">t</input>
      <input axis="y">V</input>
    </graph>
    <value label="Value" precision="5">
      <input>V</input>
    </value>
    <value label="str" precision="3">
      <input>str</input>
    </value>
    <value label="dec" precision="3">
      <input>dec</input>
    </value>
    <value label="unit" precision="3">
      <input>unit</input>
    </value>
    <value label="18value" precision="3">
      <input>18value</input>
    </value>
    <value label="18bitmask" precision="3">
      <input>18bitmask</input>
    </value>
  </view>
  <view label="Setup">
    <info label="Choose the actual meter model before interpreting a trace. Unknown B35T decimal or unit codes produce gaps. W18B decoding is provisional and needs known positive and negative packet tests on the actual meter." />
    <info label="Keep the meter mode fixed throughout one run and verify the indicated base unit against the display. Record a stable reference, zero and a reversed polarity where appropriate. Exported raw fields preserve the decoder evidence. Receive timestamps measure packet arrival, not the meter conversion instant." />
  </view>
</views>
    <export>
  <set name="Raw Data">
    <data name="Time (s)">t</data>
    <data name="y">V</data>
  </set>
  <set name="Decoder fields">
    <data name="Time (s)">tin</data>
    <data name="Meter model">meter_model</data>
    <data name="B35T numeric field">str</data>
    <data name="B35T decimal code">dec</data>
    <data name="B35T unit code">unit</data>
    <data name="W18B word">18value</data>
    <data name="W18B bitmask">18bitmask</data>
  </set>
</export>
</phyphox>
