    <input>
        <bluetooth name="SensorTag" mode="notification" rate="1" subscribeOnStart="false">
            <config char="F000AA44-0451-4000-B000-000000000000" conversion="hexadecimal">64</config>
            <config char="F000AA42-0451-4000-B000-000000000000" conversion="hexadecimal">01</config>
            <output char="F000AA41-0451-4000-B000-000000000000" conversion="int24LittleEndian" offset="0" length="3">tempRaw1</output>
            <config char="F000AA03-0451-4000-B000-000000000000" conversion="hexadecimal">1E</config>
            <config char="F000AA02-0451-4000-B000-000000000000" conversion="hexadecimal">01</config>
            <output char="F000AA01-0451-4000-B000-000000000000" conversion="int16LittleEndian" offset="0" length="2">objRaw1</output>
            <output char="F000AA01-0451-4000-B000-000000000000" conversion="int16LittleEndian" offset="2" length="2">ambRaw1</output>
            <config char="F000AA73-0451-4000-B000-000000000000" conversion="hexadecimal">50</config>
            <config char="F000AA72-0451-4000-B000-000000000000" conversion="hexadecimal">01</config>
            <output char="F000AA71-0451-4000-B000-000000000000" conversion="uInt16LittleEndian" offset="0" length="2">RawInt1</output>
            <output char="F000AA41-0451-4000-B000-000000000000" extra="time">bmp_t1</output>
            <output char="F000AA01-0451-4000-B000-000000000000" extra="time">ir_t1</output>
            <output char="F000AA71-0451-4000-B000-000000000000" extra="time">light_t1</output>
        </bluetooth>
        <bluetooth name="SensorTag" mode="notification" rate="1" subscribeOnStart="false">
            <config char="F000AA44-0451-4000-B000-000000000000" conversion="hexadecimal">64</config>
            <config char="F000AA42-0451-4000-B000-000000000000" conversion="hexadecimal">01</config>
            <output char="F000AA41-0451-4000-B000-000000000000" conversion="int24LittleEndian" offset="0" length="3">tempRaw2</output>
            <config char="F000AA03-0451-4000-B000-000000000000" conversion="hexadecimal">1E</config>
            <config char="F000AA02-0451-4000-B000-000000000000" conversion="hexadecimal">01</config>
            <output char="F000AA01-0451-4000-B000-000000000000" conversion="int16LittleEndian" offset="0" length="2">objRaw2</output>
            <output char="F000AA01-0451-4000-B000-000000000000" conversion="int16LittleEndian" offset="2" length="2">ambRaw2</output>
            <config char="F000AA73-0451-4000-B000-000000000000" conversion="hexadecimal">50</config>
            <config char="F000AA72-0451-4000-B000-000000000000" conversion="hexadecimal">01</config>
            <output char="F000AA71-0451-4000-B000-000000000000" conversion="uInt16LittleEndian" offset="0" length="2">RawInt2</output>
            <output char="F000AA41-0451-4000-B000-000000000000" extra="time">bmp_t2</output>
            <output char="F000AA01-0451-4000-B000-000000000000" extra="time">ir_t2</output>
            <output char="F000AA71-0451-4000-B000-000000000000" extra="time">light_t2</output>
        </bluetooth>
    </input>
    <output>
    </output>
    <analysis sleep="0" onUserInput="false">
        <multiply>
            <input as="factor" clear="false">tempRaw1</input>
            <input as="factor" type="value">0.01</input>
            <output as="product">tempCal1</output>
        </multiply>
        <max>
            <input as="y" clear="false">tempCal1</input>
            <output as="max">T_max1</output>
        </max>
        <min multiple="false">
            <input as="y" clear="false">tempCal1</input>
            <output as="min">T_min1</output>
        </min>
        <formula formula="floor([1_]/4)*0.03125">
            <input clear="false">ambRaw1</input>
            <output clear="true">ambCal1</output>
        </formula>
        <formula formula="floor([1_]/4)*0.03125">
            <input clear="false">objRaw1</input>
            <output clear="true">objCal1</output>
        </formula>
        <max>
            <input as="y" clear="false">objCal1</input>
            <output as="max">T_max1_obj</output>
        </max>
        <max>
            <input as="y" clear="false">ambCal1</input>
            <output as="max">T_max1_amb</output>
        </max>
        <min multiple="false">
            <input as="y" clear="false">objCal1</input>
            <output as="min">T_min1_obj</output>
        </min>
        <min multiple="false">
            <input as="y" clear="false">ambCal1</input>
            <output as="min">T_min1_amb</output>
        </min>
        <formula formula="floor([1_]/4096)">
            <input as="in" clear="false">RawInt1</input>
            <output as="out">e1</output>
        </formula>
        <formula formula="[2_]-[1_]*4096">
            <input as="in" clear="false">e1</input>
            <input as="in" clear="false">RawInt1</input>
            <output as="out">m1</output>
        </formula>
        <power>
            <input as="base" type="value">2</input>
            <input as="exponent" clear="false">e1</input>
            <output as="power">factor1</output>
        </power>
        <formula formula="[2_]*(0.01*[1_])">
            <input as="in" clear="false">factor1</input>
            <input as="in" clear="false">m1</input>
            <output as="out">amplitude1</output>
        </formula>
        <max>
            <input as="y" clear="false">amplitude1</input>
            <output as="max">amplitude_max1</output>
        </max>
        <min multiple="false">
            <input as="y" clear="false">amplitude1</input>
            <output as="min">amplitude_min1</output>
        </min>
        <multiply>
            <input as="factor" clear="false">tempRaw2</input>
            <input as="factor" type="value">0.01</input>
            <output as="product">tempCal2</output>
        </multiply>
        <max>
            <input as="y" clear="false">tempCal2</input>
            <output as="max">T_max2</output>
        </max>
        <min multiple="false">
            <input as="y" clear="false">tempCal2</input>
            <output as="min">T_min2</output>
        </min>
        <formula formula="floor([1_]/4)*0.03125">
            <input clear="false">ambRaw2</input>
            <output clear="true">ambCal2</output>
        </formula>
        <formula formula="floor([1_]/4)*0.03125">
            <input clear="false">objRaw2</input>
            <output clear="true">objCal2</output>
        </formula>
        <max>
            <input as="y" clear="false">objCal2</input>
            <output as="max">T_max2_obj</output>
        </max>
        <max>
            <input as="y" clear="false">ambCal2</input>
            <output as="max">T_max2_amb</output>
        </max>
        <min multiple="false">
            <input as="y" clear="false">objCal2</input>
            <output as="min">T_min2_obj</output>
        </min>
        <min multiple="false">
            <input as="y" clear="false">ambCal2</input>
            <output as="min">T_min2_amb</output>
        </min>
        <formula formula="floor([1_]/4096)">
            <input as="in" clear="false">RawInt2</input>
            <output as="out">e2</output>
        </formula>
        <formula formula="[2_]-[1_]*4096">
            <input as="in" clear="false">e2</input>
            <input as="in" clear="false">RawInt2</input>
            <output as="out">m2</output>
        </formula>
        <power>
            <input as="base" type="value">2</input>
            <input as="exponent" clear="false">e2</input>
            <output as="power">factor2</output>
        </power>
        <formula formula="[2_]*(0.01*[1_])">
            <input as="in" clear="false">factor2</input>
            <input as="in" clear="false">m2</input>
            <output as="out">amplitude2</output>
        </formula>
        <max>
            <input as="y" clear="false">amplitude2</input>
            <output as="max">amplitude_max2</output>
        </max>
        <min multiple="false">
            <input as="y" clear="false">amplitude2</input>
            <output as="min">amplitude_min2</output>
        </min>
        <formula formula="[1_]-[2]">
            <input clear="false">tempCal1</input>
            <input clear="false">tempCalBaseline1</input>
            <output clear="true">tempCal1_rise</output>
        </formula>
        <formula formula="[1_]-[2]">
            <input clear="false">tempCal2</input>
            <input clear="false">tempCalBaseline2</input>
            <output clear="true">tempCal2_rise</output>
        </formula>
        <formula formula="[1_]-[2]">
            <input clear="false">objCal1</input>
            <input clear="false">objCalBaseline1</input>
            <output clear="true">objCal1_rise</output>
        </formula>
        <formula formula="[1_]-[2]">
            <input clear="false">objCal2</input>
            <input clear="false">objCalBaseline2</input>
            <output clear="true">objCal2_rise</output>
        </formula>
        <formula formula="[1_]-[2]">
            <input clear="false">ambCal1</input>
            <input clear="false">ambCalBaseline1</input>
            <output clear="true">ambCal1_rise</output>
        </formula>
        <formula formula="[1_]-[2]">
            <input clear="false">ambCal2</input>
            <input clear="false">ambCalBaseline2</input>
            <output clear="true">ambCal2_rise</output>
        </formula>
    </analysis>
    <views>
        <view label="BMP280 die temperature">
            <info label="Sensor #1 (S1), orange" />
            <graph label="BMP280 die temperature" partialUpdate="false" labelX="t" labelY="T" unitX="s" unitY="°C" xPrecision="0" yPrecision="1">
                <input axis="x">bmp_t1</input>
                <input axis="y" color="orange">tempCal1</input>
            </graph>
            <separator height="1" />
            <value label="Max. BMP280 die 1" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_max1</input>
            </value>
            <value label="Min. BMP280 die 1" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_min1</input>
            </value>
            <separator height="1" />
            <info label="Sensor #2 (S2), blue" />
            <graph label="BMP280 die temperature" partialUpdate="false" labelX="t" labelY="T" unitX="s" unitY="°C" xPrecision="0" yPrecision="1">
                <input axis="x">bmp_t2</input>
                <input axis="y" color="blue">tempCal2</input>
            </graph>
            <separator height="1" />
            <value label="Max. BMP280 die 2" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_max2</input>
            </value>
            <value label="Min. BMP280 die 2" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_min2</input>
            </value>
            <separator height="1" />
            <info label="Combined comparison" />
            <graph label="BMP280 die temperature" partialUpdate="false" labelX="t" labelY="T" unitX="s" unitY="°C" xPrecision="0" yPrecision="1">
                <input axis="x">bmp_t1</input>
                <input axis="y" color="orange">tempCal1</input>
                <input axis="x">bmp_t2</input>
                <input axis="y" color="blue">tempCal2</input>
            </graph>
        </view>
        <view label="IR">
            <info label="Sensor #1 (S1), orange" />
            <graph label="TMP007 detector die temperature" partialUpdate="false" labelX="t" labelY="T" unitX="s" unitY="°C" xPrecision="0" yPrecision="1">
                <input axis="x">ir_t1</input>
                <input axis="y" color="orange">ambCal1</input>
            </graph>
            <separator height="1" />
            <value label="Max. TMP007 die 1" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_max1_amb</input>
            </value>
            <value label="Min. TMP007 die 1" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_min1_amb</input>
            </value>
            <separator height="1" />
            <graph label="TMP007 object temperature" partialUpdate="false" labelX="t" labelY="T" unitX="s" unitY="°C" xPrecision="0" yPrecision="1">
                <input axis="x">ir_t1</input>
                <input axis="y" color="orange">objCal1</input>
            </graph>
            <separator height="1" />
            <value label="Max. IR S1" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_max1_obj</input>
            </value>
            <value label="Min. IR S1" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_min1_obj</input>
            </value>
            <separator height="1" />
            <info label="Sensor #2 (S2), blue" />
            <graph label="TMP007 detector die temperature" partialUpdate="false" labelX="t" labelY="T" unitX="s" unitY="°C" xPrecision="0" yPrecision="1">
                <input axis="x">ir_t2</input>
                <input axis="y" color="blue">ambCal2</input>
            </graph>
            <separator height="1" />
            <value label="Max. TMP007 die 2" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_max2_amb</input>
            </value>
            <value label="Min. TMP007 die 2" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_min2_amb</input>
            </value>
            <separator height="1" />
            <graph label="TMP007 object temperature" partialUpdate="false" labelX="t" labelY="T" unitX="s" unitY="°C" xPrecision="0" yPrecision="1">
                <input axis="x">ir_t2</input>
                <input axis="y" color="blue">objCal2</input>
            </graph>
            <separator height="1" />
            <value label="Max. IR S2" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_max2_obj</input>
            </value>
            <value label="Min. IR S2" size="2" precision="2" scientific="false" unit="°C" factor="1">
                <input>T_min2_obj</input>
            </value>
            <separator height="1" />
            <info label="Combined comparison" />
            <graph label="TMP007 detector die temperature" labelX="t" unitX="s" labelY="T" unitY="°C" partialUpdate="false">
                <input axis="x">ir_t1</input>
                <input axis="y" color="orange">ambCal1</input>
                <input axis="x">ir_t2</input>
                <input axis="y" color="blue">ambCal2</input>
            </graph>
            <graph label="TMP007 object temperature" labelX="t" unitX="s" labelY="T" unitY="°C" partialUpdate="false">
                <input axis="x">ir_t1</input>
                <input axis="y" color="orange">objCal1</input>
                <input axis="x">ir_t2</input>
                <input axis="y" color="blue">objCal2</input>
            </graph>
        </view>
        <view label="Light">
            <info label="Sensor #1 (S1), orange" />
            <graph label="Illuminance" labelX="t" unitX="s" labelY="Ev" unitY="lx" partialUpdate="false">
                <input axis="x">light_t1</input>
                <input axis="y" color="orange">amplitude1</input>
            </graph>
            <separator height="1" />
            <value label="Max. Illum. S1" size="2" precision="2" scientific="false" unit="lx" factor="1">
                <input>amplitude_max1</input>
            </value>
            <value label="Min. Illum. S1" size="2" precision="2" scientific="false" unit="lx" factor="1">
                <input>amplitude_min1</input>
            </value>
            <separator height="1" />
            <info label="Sensor #2 (S2), blue" />
            <graph label="Illuminance" labelX="t" unitX="s" labelY="Ev" unitY="lx" partialUpdate="false">
                <input axis="x">light_t2</input>
                <input axis="y" color="blue">amplitude2</input>
            </graph>
            <separator height="1" />
            <value label="Max. Illum. S2" size="2" precision="2" scientific="false" unit="lx" factor="1">
                <input>amplitude_max2</input>
            </value>
            <value label="Min. Illum. S2" size="2" precision="2" scientific="false" unit="lx" factor="1">
                <input>amplitude_min2</input>
            </value>
            <separator height="1" />
            <info label="Combined comparison" />
            <graph label="Illuminance" labelX="t" unitX="s" labelY="Ev" unitY="lx" partialUpdate="false">
                <input axis="x">light_t1</input>
                <input axis="y" color="orange">amplitude1</input>
                <input axis="x">light_t2</input>
                <input axis="y" color="blue">amplitude2</input>
            </graph>
        </view>
        <view label="Temperature rise">
            <info label="Enter each sensor's mean during the same equilibrated lamp-off interval. Zero defaults are placeholders; enter the measured baselines before interpreting temperature rises." />
            <edit label="Initial BMP280 1" unit="°C" signed="true" decimal="true" default="0">
                <output>tempCalBaseline1</output>
            </edit>
            <edit label="Initial BMP280 2" unit="°C" signed="true" decimal="true" default="0">
                <output>tempCalBaseline2</output>
            </edit>
            <graph label="BMP280 temperature rises" labelX="t" unitX="s" labelY="ΔT" unitY="K" partialUpdate="false" yPrecision="2">
                <input axis="x">bmp_t1</input>
                <input axis="y" color="orange">tempCal1_rise</input>
                <input axis="x">bmp_t2</input>
                <input axis="y" color="blue">tempCal2_rise</input>
            </graph>
            <edit label="Initial TMP007 object 1" unit="°C" signed="true" decimal="true" default="0">
                <output>objCalBaseline1</output>
            </edit>
            <edit label="Initial TMP007 object 2" unit="°C" signed="true" decimal="true" default="0">
                <output>objCalBaseline2</output>
            </edit>
            <graph label="TMP007 object temperature rises" labelX="t" unitX="s" labelY="ΔT" unitY="K" partialUpdate="false" yPrecision="2">
                <input axis="x">ir_t1</input>
                <input axis="y" color="orange">objCal1_rise</input>
                <input axis="x">ir_t2</input>
                <input axis="y" color="blue">objCal2_rise</input>
            </graph>
            <edit label="Initial TMP007 die 1" unit="°C" signed="true" decimal="true" default="0">
                <output>ambCalBaseline1</output>
            </edit>
            <edit label="Initial TMP007 die 2" unit="°C" signed="true" decimal="true" default="0">
                <output>ambCalBaseline2</output>
            </edit>
            <graph label="TMP007 detector temperature rises" labelX="t" unitX="s" labelY="ΔT" unitY="K" partialUpdate="false" yPrecision="2">
                <input axis="x">ir_t1</input>
                <input axis="y" color="orange">ambCal1_rise</input>
                <input axis="x">ir_t2</input>
                <input axis="y" color="blue">ambCal2_rise</input>
            </graph>
        </view>
        <view label="Setup">
            <info label="Fix the lamp and matched sensor mounts on the lit and shaded regions. Co-locate the tags for a baseline check and exchange their positions in a repeat run to distinguish sensor offsets from the spatial contrast." />
            <info label="BMP280 measures its die temperature. TMP007 reports inferred object temperature and detector die temperature. Keep target emissivity, viewed area, distance, orientation, airflow and support conduction fixed; check surface temperature with independent references." />
            <info label="Lux measures visible illuminance rather than total absorbed heating power. Compare temperature rises for the same sensor type over a common settled interval; report the day-side rise minus the night-side rise." />
            <info label="Times are Bluetooth receive times. Each sensor keeps its own clock; compare means over the same time interval or align the records before subtracting them." />
        </view>
    </views>
    <export>
        <set name="BMP280 1">
            <data name="Time 1 (s)">bmp_t1</data>
            <data name="BMP280 die temperature 1 (°C)">tempCal1</data>
            <data name="Temperature rise 1 (K)">tempCal1_rise</data>
        </set>
        <set name="BMP280 2">
            <data name="Time 2 (s)">bmp_t2</data>
            <data name="BMP280 die temperature 2 (°C)">tempCal2</data>
            <data name="Temperature rise 2 (K)">tempCal2_rise</data>
        </set>
        <set name="TMP007 object 1">
            <data name="Time 1 (s)">ir_t1</data>
            <data name="TMP007 object temperature 1 (°C)">objCal1</data>
            <data name="Temperature rise 1 (K)">objCal1_rise</data>
        </set>
        <set name="TMP007 object 2">
            <data name="Time 2 (s)">ir_t2</data>
            <data name="TMP007 object temperature 2 (°C)">objCal2</data>
            <data name="Temperature rise 2 (K)">objCal2_rise</data>
        </set>
        <set name="TMP007 die 1">
            <data name="Time 1 (s)">ir_t1</data>
            <data name="TMP007 die temperature 1 (°C)">ambCal1</data>
            <data name="Temperature rise 1 (K)">ambCal1_rise</data>
        </set>
        <set name="TMP007 die 2">
            <data name="Time 2 (s)">ir_t2</data>
            <data name="TMP007 die temperature 2 (°C)">ambCal2</data>
            <data name="Temperature rise 2 (K)">ambCal2_rise</data>
        </set>
        <set name="OPT3001 1">
            <data name="Time 1 (s)">light_t1</data>
            <data name="Illuminance 1 (lx)">amplitude1</data>
        </set>
        <set name="OPT3001 2">
            <data name="Time 2 (s)">light_t2</data>
            <data name="Illuminance 2 (lx)">amplitude2</data>
        </set>
        <set name="Baseline settings">
            <data name="Initial BMP280 1 (°C)">tempCalBaseline1</data>
            <data name="Initial BMP280 2 (°C)">tempCalBaseline2</data>
            <data name="Initial TMP007 object 1 (°C)">objCalBaseline1</data>
            <data name="Initial TMP007 object 2 (°C)">objCalBaseline2</data>
            <data name="Initial TMP007 die 1 (°C)">ambCalBaseline1</data>
            <data name="Initial TMP007 die 2 (°C)">ambCalBaseline2</data>
        </set>
    </export>
</phyphox>
