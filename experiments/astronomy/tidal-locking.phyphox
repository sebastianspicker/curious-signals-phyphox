            <string original="Ambient temperature 2 (°C)">Umgebungstemperatur 2 (°C)</string>
            <string original="Object temperature 2 (°C)">Objekttemperatur 2 (°C)</string>
            <string original="Light (OPT3001)">Licht (OPT3001)</string>
            <string original="Illuminance (lx)">Beleuchtungsstärke (lx)</string>
            <string original="BMP280 die temperature">BMP280-Chiptemperatur</string>
            <string original="Max. BMP280 die 1">Max. BMP280-Chip 1</string>
            <string original="Min. BMP280 die 1">Min. BMP280-Chip 1</string>
            <string original="Max. BMP280 die 2">Max. BMP280-Chip 2</string>
            <string original="Min. BMP280 die 2">Min. BMP280-Chip 2</string>
            <string original="TMP007 detector die temperature">TMP007-Detektorchiptemperatur</string>
            <string original="TMP007 object temperature">TMP007-Objekttemperatur</string>
            <string original="Max. TMP007 die 1">Max. TMP007-Chip 1</string>
            <string original="Min. TMP007 die 1">Min. TMP007-Chip 1</string>
            <string original="Max. TMP007 die 2">Max. TMP007-Chip 2</string>
            <string original="Min. TMP007 die 2">Min. TMP007-Chip 2</string>
            <string original="Temperature rise">Temperaturanstieg</string>
            <string original="Enter each sensor's mean during the same equilibrated lamp-off interval. Zero defaults are placeholders; enter the measured baselines before interpreting temperature rises.">Trage für jeden Sensor den Mittelwert desselben eingeschwungenen Zeitintervalls bei ausgeschalteter Lampe ein. Die Vorgaben null sind Platzhalter; setze die gemessenen Ausgangswerte vor der Auswertung der Temperaturanstiege.</string>
            <string original="Initial BMP280 1">Anfangswert BMP280-Chip 1</string>
            <string original="Initial BMP280 2">Anfangswert BMP280-Chip 2</string>
            <string original="BMP280 temperature rises">BMP280-Temperaturanstiege</string>
            <string original="Initial TMP007 object 1">Anfangswert TMP007-Objekt 1</string>
            <string original="Initial TMP007 object 2">Anfangswert TMP007-Objekt 2</string>
            <string original="TMP007 object temperature rises">TMP007-Objekttemperaturanstiege</string>
            <string original="Initial TMP007 die 1">Anfangswert TMP007-Detektorchip 1</string>
            <string original="Initial TMP007 die 2">Anfangswert TMP007-Detektorchip 2</string>
            <string original="TMP007 detector temperature rises">TMP007-Detektortemperaturanstiege</string>
            <string original="BMP280 1">BMP280-Chip 1</string>
            <string original="Time 1 (s)">Zeit 1 (s)</string>
            <string original="BMP280 die temperature 1 (°C)">BMP280-Chip-Temperatur 1 (°C)</string>
            <string original="Temperature rise 1 (K)">Temperaturanstieg 1 (K)</string>
            <string original="BMP280 2">BMP280-Chip 2</string>
