    <analysis>
  <formula formula="((1-sign(abs([1_]-0)))*1+(1-sign(abs([1_]-1)))*0.001+(1-sign(abs([1_]-2)))*0.01+(1-sign(abs([1_]-4)))*0.1)/((1-sign(abs([1_]-0)))+(1-sign(abs([1_]-1)))+(1-sign(abs([1_]-2)))+(1-sign(abs([1_]-4))))">
    <input clear="false" type="buffer">dec</input>
