    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">duration_candidate2</input>
    <input clear="false" type="value" as="false">NaN</input>
    <output clear="true">don2</output>
  </if>
  <formula formula="[1]-[2]">
    <input clear="false" type="buffer">on2</input>
    <input clear="false" type="buffer">on1</input>
    <output clear="true">period_candidate1</output>
  </formula>
  <if greater="true">
    <input clear="false" type="buffer" as="a">period_candidate1</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">period_candidate1</input>
    <input clear="false" type="value" as="false">NaN</input>
    <output clear="true">dt12</output>
  </if>
  <rangefilter>
    <input clear="false" type="buffer">timing_t</input>
    <input clear="false" type="buffer" as="min">off2</input>
    <input clear="false" type="buffer">timing_signal</input>
    <output clear="true">search_t_candidate</output>
    <output clear="true">search_a_candidate</output>
  </rangefilter>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">off2</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_t_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_t</output>
  </if>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">off2</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_a_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_a</output>
  </if>
  <threshold falling="true">
    <input clear="false" type="buffer" as="x">search_t</input>
    <input clear="false" type="buffer" as="y">search_a</input>
    <input clear="false" type="buffer" as="threshold">threshold_low</input>
    <output clear="true" as="position">on3</output>
  </threshold>
  <rangefilter>
    <input clear="false" type="buffer">timing_t</input>
    <input clear="false" type="buffer" as="min">on3</input>
    <input clear="false" type="buffer">timing_signal</input>
    <output clear="true">search_t_candidate</output>
    <output clear="true">search_a_candidate</output>
  </rangefilter>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">on3</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_t_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_t</output>
  </if>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">on3</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_a_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_a</output>
  </if>
  <threshold falling="false">
    <input clear="false" type="buffer" as="x">search_t</input>
    <input clear="false" type="buffer" as="y">search_a</input>
    <input clear="false" type="buffer" as="threshold">threshold_high</input>
    <output clear="true" as="position">off3</output>
  </threshold>
  <formula formula="[1]-[2]">
    <input clear="false" type="buffer">off3</input>
    <input clear="false" type="buffer">on3</input>
    <output clear="true">duration_candidate3</output>
  </formula>
  <if greater="true">
    <input clear="false" type="buffer" as="a">duration_candidate3</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">duration_candidate3</input>
    <input clear="false" type="value" as="false">NaN</input>
    <output clear="true">don3</output>
  </if>
  <formula formula="[1]-[2]">
    <input clear="false" type="buffer">on3</input>
    <input clear="false" type="buffer">on2</input>
    <output clear="true">period_candidate2</output>
  </formula>
  <if greater="true">
    <input clear="false" type="buffer" as="a">period_candidate2</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">period_candidate2</input>
    <input clear="false" type="value" as="false">NaN</input>
    <output clear="true">dt23</output>
  </if>
  <rangefilter>
    <input clear="false" type="buffer">timing_t</input>
    <input clear="false" type="buffer" as="min">off3</input>
    <input clear="false" type="buffer">timing_signal</input>
    <output clear="true">search_t_candidate</output>
    <output clear="true">search_a_candidate</output>
  </rangefilter>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">off3</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_t_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_t</output>
  </if>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">off3</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_a_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_a</output>
  </if>
  <threshold falling="true">
    <input clear="false" type="buffer" as="x">search_t</input>
    <input clear="false" type="buffer" as="y">search_a</input>
    <input clear="false" type="buffer" as="threshold">threshold_low</input>
    <output clear="true" as="position">on4</output>
  </threshold>
  <rangefilter>
    <input clear="false" type="buffer">timing_t</input>
    <input clear="false" type="buffer" as="min">on4</input>
    <input clear="false" type="buffer">timing_signal</input>
    <output clear="true">search_t_candidate</output>
    <output clear="true">search_a_candidate</output>
  </rangefilter>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">on4</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_t_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_t</output>
  </if>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">on4</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_a_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_a</output>
  </if>
  <threshold falling="false">
    <input clear="false" type="buffer" as="x">search_t</input>
    <input clear="false" type="buffer" as="y">search_a</input>
    <input clear="false" type="buffer" as="threshold">threshold_high</input>
    <output clear="true" as="position">off4</output>
  </threshold>
  <formula formula="[1]-[2]">
    <input clear="false" type="buffer">off4</input>
    <input clear="false" type="buffer">on4</input>
    <output clear="true">duration_candidate4</output>
  </formula>
  <if greater="true">
    <input clear="false" type="buffer" as="a">duration_candidate4</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">duration_candidate4</input>
    <input clear="false" type="value" as="false">NaN</input>
    <output clear="true">don4</output>
  </if>
  <formula formula="[1]-[2]">
    <input clear="false" type="buffer">on4</input>
    <input clear="false" type="buffer">on3</input>
    <output clear="true">period_candidate3</output>
  </formula>
  <if greater="true">
    <input clear="false" type="buffer" as="a">period_candidate3</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">period_candidate3</input>
    <input clear="false" type="value" as="false">NaN</input>
    <output clear="true">dt34</output>
  </if>
  <rangefilter>
    <input clear="false" type="buffer">timing_t</input>
    <input clear="false" type="buffer" as="min">off4</input>
    <input clear="false" type="buffer">timing_signal</input>
    <output clear="true">search_t_candidate</output>
    <output clear="true">search_a_candidate</output>
  </rangefilter>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">off4</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_t_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_t</output>
  </if>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">off4</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_a_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_a</output>
  </if>
  <threshold falling="true">
    <input clear="false" type="buffer" as="x">search_t</input>
    <input clear="false" type="buffer" as="y">search_a</input>
    <input clear="false" type="buffer" as="threshold">threshold_low</input>
    <output clear="true" as="position">on5</output>
  </threshold>
  <rangefilter>
    <input clear="false" type="buffer">timing_t</input>
    <input clear="false" type="buffer" as="min">on5</input>
    <input clear="false" type="buffer">timing_signal</input>
    <output clear="true">search_t_candidate</output>
    <output clear="true">search_a_candidate</output>
  </rangefilter>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">on5</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_t_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_t</output>
  </if>
  <if greater="true" equal="true">
    <input clear="false" type="buffer" as="a">on5</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">search_a_candidate</input>
    <input clear="false" type="empty" as="false" />
    <output clear="true">search_a</output>
  </if>
  <threshold falling="false">
    <input clear="false" type="buffer" as="x">search_t</input>
    <input clear="false" type="buffer" as="y">search_a</input>
    <input clear="false" type="buffer" as="threshold">threshold_high</input>
    <output clear="true" as="position">off5</output>
  </threshold>
  <formula formula="[1]-[2]">
    <input clear="false" type="buffer">off5</input>
    <input clear="false" type="buffer">on5</input>
    <output clear="true">duration_candidate5</output>
  </formula>
  <if greater="true">
    <input clear="false" type="buffer" as="a">duration_candidate5</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">duration_candidate5</input>
    <input clear="false" type="value" as="false">NaN</input>
    <output clear="true">don5</output>
  </if>
  <formula formula="[1]-[2]">
    <input clear="false" type="buffer">on5</input>
    <input clear="false" type="buffer">on4</input>
    <output clear="true">period_candidate4</output>
  </formula>
  <if greater="true">
    <input clear="false" type="buffer" as="a">period_candidate4</input>
    <input clear="false" type="value" as="b">0</input>
    <input clear="false" type="buffer" as="true">period_candidate4</input>
    <input clear="false" type="value" as="false">NaN</input>
    <output clear="true">dt45</output>
  </if>
  <append>
    <input clear="false" type="buffer">don0</input>
    <input clear="false" type="buffer">don1</input>
    <input clear="false" type="buffer">don2</input>
    <input clear="false" type="buffer">don3</input>
    <input clear="false" type="buffer">don4</input>
    <input clear="false" type="buffer">don5</input>
    <output clear="true">duration_list</output>
  </append>
  <append>
    <input clear="false" type="buffer">dt01</input>
    <input clear="false" type="buffer">dt12</input>
    <input clear="false" type="buffer">dt23</input>
    <input clear="false" type="buffer">dt34</input>
    <input clear="false" type="buffer">dt45</input>
    <output clear="true">period_list</output>
  </append>
  <match>
    <input clear="false" type="buffer">duration_list</input>
    <output clear="true">valid_durations</output>
  </match>
  <count>
    <input clear="false" type="buffer" as="buffer">valid_durations</input>
    <output clear="true" as="count">complete_count</output>
  </count>
  <average>
    <input clear="false" type="buffer" as="buffer">duration_list</input>
    <output clear="true" as="average">avg_transit_time</output>
  </average>
  <average>
    <input clear="false" type="buffer" as="buffer">period_list</input>
    <output clear="true" as="average">avg_year_duration</output>
  </average>
</analysis>

  <views>
  <view label="Relative Signal">
    <edit label="Signal source (1 phone, 2 SensorTag, 3 Owon)" default="1" decimal="false" signed="true" min="1" max="3">
      <output>source</output>
    </edit>
    <edit label="Owon model (1 B35T, 2 W18B)" default="1" decimal="false" signed="true" min="1" max="2">
      <output>meter_model</output>
    </edit>
    <graph label="Signal-time diagram" labelX="t" labelY="Signal" unitX="s" unitY="a.u." partialUpdate="false">
      <input axis="x">t</input>
      <input axis="y">amplitude</input>
    </graph>
    <graph label="Normalized signal" labelX="t" labelY="S/S0" unitX="s" unitY="" partialUpdate="false">
      <input axis="x">t</input>
      <input axis="y">normalized</input>
    </graph>
    <value label="Maximum Signal" precision="3">
      <input>max_amplitude</input>
    </value>
    <value label="Complete events" precision="0">
      <input>complete_count</input>
    </value>
    <value label="Mean threshold duration" precision="3" unit="s">
      <input>avg_transit_time</input>
    </value>
    <value label="Mean onset period" precision="3" unit="s">
      <input>avg_year_duration</input>
    </value>
  </view>
  <view label="Planet Size">
    <edit label="Use entered means (0 or 1)" default="0" decimal="false" signed="true" min="0" max="1">
      <output>use_means</output>
    </edit>
    <edit label="Dark/background mean" default="0" decimal="true" signed="true" unit="a.u.">
      <output>dark</output>
    </edit>
    <edit label="Baseline mean" default="0" decimal="true" signed="true" unit="a.u.">
      <output>baseline</output>
    </edit>
    <edit label="Transit plateau mean" default="0" decimal="true" signed="true" unit="a.u.">
      <output>plateau</output>
    </edit>
    <edit label="Star radius" default="1" decimal="true" signed="true" unit="cm" min="1e-06">
      <output>R_star</output>
    </edit>
    <edit label="Distance ratio dp/ds" default="1" decimal="true" signed="true" min="1e-06">
      <output>distance_ratio</output>
    </edit>
    <value label="Local transit depth" precision="3" unit="%">
      <input>transit_depth</input>
    </value>
    <value label="Planet radius" precision="3" unit="cm">
      <input>R_planet</input>
    </value>
    <value label="Planet size relative to star" precision="3" unit="%">
      <input>Quot_R</input>
    </value>
    <info label="Enter settled local baseline and transit-plateau means from one event, with a measured background in the same signal units, then enable the reduction. Depth is (baseline-plateau)/(baseline-dark). Invalid denominators and depths outside 0 to 1 are unavailable. The radius assumes a uniform source, complete overlap and linear detector response." />
  </view>
  <view label="Trigger Configuration">
    <edit label="Lower normalized threshold" default="0.99" decimal="true" signed="true" min="0" max="1">
      <output>threshold_low</output>
    </edit>
    <edit label="Upper normalized threshold" default="0.995" decimal="true" signed="true" min="0" max="1">
      <output>threshold_high</output>
    </edit>
    <info label="Set the local baseline/background above before timing. Use lower &lt; upper, both between plateau and baseline. Falling lower crossings start an event; rising upper crossings finish it. Initial partial dips are ignored. Means use available complete events (up to six) and onset intervals. These are threshold durations; sampling, integration and receive latency limit their interpretation." />
  </view>
  <view label="Transit Duration">
    <value label="Event 1 threshold duration" precision="3" unit="s">
      <input>don0</input>
    </value>
    <value label="Event 2 threshold duration" precision="3" unit="s">
      <input>don1</input>
    </value>
    <value label="Event 3 threshold duration" precision="3" unit="s">
      <input>don2</input>
    </value>
    <value label="Event 4 threshold duration" precision="3" unit="s">
      <input>don3</input>
    </value>
    <value label="Event 5 threshold duration" precision="3" unit="s">
      <input>don4</input>
    </value>
    <value label="Event 6 threshold duration" precision="3" unit="s">
      <input>don5</input>
    </value>
    <value label="Mean threshold duration" precision="3" unit="s">
      <input>avg_transit_time</input>
    </value>
  </view>
  <view label="Orbital Period">
    <value label="Onset interval 1" precision="3" unit="s">
      <input>dt01</input>
    </value>
    <value label="Onset interval 2" precision="3" unit="s">
      <input>dt12</input>
    </value>
    <value label="Onset interval 3" precision="3" unit="s">
      <input>dt23</input>
    </value>
    <value label="Onset interval 4" precision="3" unit="s">
      <input>dt34</input>
    </value>
    <value label="Onset interval 5" precision="3" unit="s">
      <input>dt45</input>
    </value>
    <value label="Mean onset period" precision="3" unit="s">
      <input>avg_year_duration</input>
    </value>
  </view>
  <view label="Setup">
    <info label="Keep the lamp, detector and occulting track rigid. Measure source radius and both distances from the detector: Rp=Rs*(dp/ds)*sqrt(depth). Bracket each transit with nearby unobscured baseline measurements and measure background separately. Check clipping, source uniformity and detector linearity; keep photocell loading defined when using voltage." />
    <info label="Select one signal source and keep its calibration separate. Source selection controls analysis; configured Bluetooth inputs can still request connections. Clear data before changing apparatus or meter model. Each source keeps its own raw history and time; Bluetooth timestamps are arrival times, so missed packets remain time gaps." />
    <info label="Choose the actual meter model before interpreting a trace. Unknown B35T decimal or unit codes produce gaps. W18B decoding is provisional and needs known positive and negative packet tests on the actual meter." />
  </view>
</views>

  <export>
  <set name="Raw">
    <data name="t (s)">t</data>
    <data name="Relative Signal (a.u.)">amplitude</data>
    <data name="Normalized signal">normalized</data>
  </set>
  <set name="Phone Raw">
    <data name="t (s)">phone_t</data>
    <data name="Signal (a.u.)">phone_amplitude</data>
  </set>
  <set name="SensorTag Raw">
    <data name="t (s)">st_t</data>
    <data name="Signal (a.u.)">st_amplitude</data>
    <data name="OPT3001 word">RawInt</data>
  </set>
  <set name="Owon Raw">
    <data name="t (s)">meter_t</data>
    <data name="Signal (base unit)">V</data>
    <data name="B35T numeric field">str</data>
    <data name="B35T decimal code">dec</data>
    <data name="B35T unit code">unit</data>
    <data name="W18B word">18value</data>
    <data name="W18B bitmask">18bitmask</data>
  </set>
  <set name="Timing">
    <data name="On 0 (s)">on0</data>
    <data name="On 1 (s)">on1</data>
    <data name="On 2 (s)">on2</data>
    <data name="On 3 (s)">on3</data>
    <data name="On 4 (s)">on4</data>
    <data name="On 5 (s)">on5</data>
    <data name="Off 0 (s)">off0</data>
    <data name="Off 1 (s)">off1</data>
    <data name="Off 2 (s)">off2</data>
    <data name="Off 3 (s)">off3</data>
    <data name="Off 4 (s)">off4</data>
    <data name="Off 5 (s)">off5</data>
  </set>
  <set name="Reduction settings">
    <data name="Source">source</data>
    <data name="Meter model">meter_model</data>
    <data name="Background">dark</data>
    <data name="Baseline">baseline</data>
    <data name="Plateau">plateau</data>
    <data name="Use entered means (0 or 1)">use_means</data>
    <data name="Star radius (cm)">R_star</data>
    <data name="Distance ratio dp/ds">distance_ratio</data>
    <data name="Lower normalized threshold">threshold_low</data>
    <data name="Upper normalized threshold">threshold_high</data>
    <data name="Local transit depth (%)">transit_depth</data>
    <data name="Planet radius (cm)">R_planet</data>
    <data name="Complete events">complete_count</data>
    <data name="Mean threshold duration (s)">avg_transit_time</data>
    <data name="Mean onset period (s)">avg_year_duration</data>
  </set>
</export>
</phyphox>
